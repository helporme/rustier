{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "features": "all",
          "extraEnv": {
            "RUSTUP_TOOLCHAIN": "nightly",
          },
        },
        "rustfmt": {
          // supports doc string wrap
          "extraArgs": ["+nightly"],
        },
      },
    },
  },
  "file_types": {
    "Markdown": ["snap", "new"],
  },
}
