{
  "name": "rust-curse",
  "version": "0.1.0",
  "description": "Vite plugin to import rust code in your js/ts code.",
  "type": "module",
  "scripts": {
    "build:ts": "tsdown",
    "build:native": "cd ../rust-curse-native && npm run build",
    "build": "npm run build:native && npm run build:ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/cli": "^3.6.2",
    "@types/node": "^25.6.2",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.20",
    "rust-curse-native": "workspace:*",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  },
  "exports": {
    "./tsdown": "./dist/tsdown.mjs",
    "./utils": "./dist/utils.mjs"
  },
  "peerDependencies": {
    "tsdown": "^0.22.0"
  },
  "peerDependenciesMeta": {
    "tsdown": {
      "optional": true
    }
  }
}
