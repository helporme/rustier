# Compiled
## Node
```rust
fn cast(input: ()) {
    {
        let mut __cast_owned_value = {
            let type_name = "i16";
            let value = input;
            if value.trunc() != value || value < i16::MIN as f64
                || value > i16::MAX as f64
            {
                return Err(
                    rustier_rt::CastError {
                        value,
                        target: type_name,
                    }
                        .into(),
                );
            }
            value as i16
        };
        let output = &__cast_owned_value;
        consume(output);
    }
}
```

