# Compiled
## Node
```rust
fn cast(input: ()) {
    {
        let output = {
            let value = {
                let type_name = "u32";
                let value = input;
                if value.trunc() != value || value < 0 as f64 || value > u32::MAX as f64
                {
                    return Err(
                        rustier_rt::CastError {
                            value,
                            target: type_name,
                        }
                            .into(),
                    );
                }
                value as u32
            };
            char::from_u32(value)
                .ok_or(rustier_rt::CastError {
                    value: value as f64,
                    target: "char",
                })?
        };
        consume(output);
    }
}
```

