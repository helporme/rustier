# Compiled
## Node
```rust
fn cast(input: ()) {
    {
        let mut __cast_owned_value = {
            let type_name = "u8";
            let value = input;
            if value.trunc() != value || value < 0 as f64 || value > u8::MAX as f64 {
                return Err(
                    napi::Error::from_reason(
                        format!("cannot cast {value} to {type_name}"),
                    ),
                );
            }
            value as u8
        };
        let output = &mut __cast_owned_value;
        consume(output);
    }
}
```

