# Compiled
## Node
```rust
fn cast(input: ()) {
    {
        let mut __cast_owned_value = {
            let type_name = "u32";
            let value = input;
            if value.trunc() != value || value < 0 as f64 || value > u32::MAX as f64 {
                return Err(
                    rustier_rt::CastError {
                        value,
                        target: type_name,
                    }
                        .into(),
                );
            }
            value as u32
        };
        let output = &__cast_owned_value;
        consume(output);
    }
}
```

