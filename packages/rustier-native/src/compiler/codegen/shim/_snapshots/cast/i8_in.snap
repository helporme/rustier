fn cast(input: ()) {
    {
        let output = {
            let type_name = "i8";
            let value = input;
            if value.trunc() != value || value < i8::MIN as f64 || value > i8::MAX as f64
            {
                return Err(
                    JsValue::from_str(&format!("cannot cast {value} to {type_name}")),
                );
            }
            value as i8
        };
        consume(output);
