# Compiled

```js
function cast(
	input
) {
	{
		const __cast_input = input;
		if(
			typeof __cast_input !== "number"
		) {
			throw new TypeError(
				"Expected a value of type \"number\", but value of type \"" + typeof __cast_input + "\" was passed: \"" + String(
					__cast_input
				) + "\""
			);
		}
		const output = __cast_input;
		consume(
			output
		);
	}
}
```
