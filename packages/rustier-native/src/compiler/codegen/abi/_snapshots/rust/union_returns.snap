#[napi(js_name = "choose")]
pub fn choose(
    _0: f64,
) -> napi::Result<(u32, napi::bindgen_prelude::Either5<(), f64, bool, String, u64>)> {
    enum __AbiReturn {
        V0(()),
        V1(f64),
        V2(bool),
        V3(String),
        V4(usize),
        V5(String),
        V6(()),
    }
    let result: napi::Result<__AbiReturn> = {
        match _0 as u32 {
            0 => Ok(__AbiReturn::V0(())),
            1 => Ok(__AbiReturn::V1(42.5)),
            2 => Ok(__AbiReturn::V2(true)),
            3 => Ok(__AbiReturn::V3(String::from("first"))),
            4 => Ok(__AbiReturn::V4(7usize)),
            5 => Ok(__AbiReturn::V5(String::new())),
            6 => Ok(__AbiReturn::V6(())),
            _ => Ok(__AbiReturn::V0(())),
        }
    };
    result
        .and_then(|result| match result {
            __AbiReturn::V0(()) => Ok((0u32, napi::bindgen_prelude::Either5::A(()))),
            __AbiReturn::V1(value) => {
                Ok((1u32, napi::bindgen_prelude::Either5::B(value)))
            }
            __AbiReturn::V2(value) => {
                Ok((2u32, napi::bindgen_prelude::Either5::C(value)))
            }
            __AbiReturn::V3(value) => {
                Ok((3u32, napi::bindgen_prelude::Either5::D(value)))
            }
            __AbiReturn::V4(value) => {
                Ok((
                    4u32,
                    napi::bindgen_prelude::Either5::E(
                        u64::try_from(value)
                            .map_err(|_| napi::Error::from_reason(
                                "usize value is outside the transport range".to_string(),
                            ))?,
                    ),
                ))
            }
            __AbiReturn::V5(value) => {
                Ok((5u32, napi::bindgen_prelude::Either5::D(value)))
            }
            __AbiReturn::V6(()) => Ok((6u32, napi::bindgen_prelude::Either5::A(()))),
        })
}
