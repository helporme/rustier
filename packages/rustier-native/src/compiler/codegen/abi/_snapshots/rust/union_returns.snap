    enum __AbiReturn {
        V0(()),
        V1(f64),
        V2(bool),
        V3(String),
        V4(usize),
        V5(String),
        V6(()),
    }
    let result: __AbiReturn = {
        match _0 as u32 {
            0 => __AbiReturn::V0(()),
            1 => __AbiReturn::V1(42.5),
            2 => __AbiReturn::V2(true),
            3 => __AbiReturn::V3(String::from("first")),
            4 => __AbiReturn::V4(7usize),
            5 => __AbiReturn::V5(String::new()),
            6 => __AbiReturn::V6(()),
            _ => __AbiReturn::V0(()),
        }
    };
    match result {
        __AbiReturn::V0(()) => (0u32, napi::bindgen_prelude::Either5::A(())),
        __AbiReturn::V1(value) => (1u32, napi::bindgen_prelude::Either5::B(value)),
        __AbiReturn::V2(value) => (2u32, napi::bindgen_prelude::Either5::C(value)),
        __AbiReturn::V3(value) => (3u32, napi::bindgen_prelude::Either5::D(value)),
        __AbiReturn::V4(value) => (4u32, napi::bindgen_prelude::Either5::E(value as u64)),
        __AbiReturn::V5(value) => (5u32, napi::bindgen_prelude::Either5::D(value)),
        __AbiReturn::V6(()) => (6u32, napi::bindgen_prelude::Either5::A(())),
    }
}
