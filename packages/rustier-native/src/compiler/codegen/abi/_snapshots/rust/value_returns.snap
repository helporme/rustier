#[napi(js_name = "unit")]
pub fn unit() -> napi::Result<()> {
    let result: napi::Result<()> = { Ok(()) };
    result
}
#[napi(js_name = "number")]
pub fn number(_0: f64) -> napi::Result<f64> {
    let result: napi::Result<f64> = { Ok(_0) };
    result
}
#[napi(js_name = "boolean")]
pub fn boolean(_0: bool) -> napi::Result<bool> {
    let result: napi::Result<bool> = { Ok(_0) };
    result
}
#[napi(js_name = "string")]
pub fn string(_0: String) -> napi::Result<String> {
    let result: napi::Result<String> = { Ok(_0) };
    result
}
#[napi(js_name = "handle")]
pub fn handle(_0: napi::bindgen_prelude::BigInt) -> napi::Result<u64> {
    let _0 = usize::try_from({
            let (negative, value, lossless) = _0.get_u64();
            if negative || !lossless {
                return Err(
                    napi::Error::from_reason(
                        "ABI value is outside the usize range".to_string(),
                    ),
                );
            }
            value
        })
        .map_err(|_| napi::Error::from_reason(
            "ABI value is outside the usize range".to_string(),
        ))?;
    let result: napi::Result<usize> = { Ok(_0) };
    result
        .and_then(|result| {
            u64::try_from(result)
                .map_err(|_| napi::Error::from_reason(
                    "usize value is outside the transport range".to_string(),
                ))
        })
}
