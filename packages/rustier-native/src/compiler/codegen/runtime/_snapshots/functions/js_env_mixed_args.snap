# Source

```rust
pub use rustier_ext::runtime::js::JsEnv as Environment;
type Alias = Environment;
pub fn combine(
    _first: Environment,
    left: i32,
    _middle: Alias,
    right: &i32,
    _last: Environment,
) -> i32 {
    left + right
}
```

