# Source

```rust
pub struct Holder(pub u32);
///An event carrying a generic value.
#[derive(Clone)]
pub enum Event<T> {
    ///Carries a value.
    Value(T),
    Empty,
}
impl<T> Event<T> {
    pub fn new(value: T) -> Self {
        Self::Value(value)
    }
    pub fn is_empty(&self) -> bool {
        false
    }
}
pub fn consume(number: &Event<u32>, holder: &Event<Holder>) {}
```

