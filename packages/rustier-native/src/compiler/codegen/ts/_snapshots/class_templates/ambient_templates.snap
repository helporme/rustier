#[derive(Clone)]
pub enum Event<T> {
    Value { value: T },
    Empty,
}
pub fn consume(
    wrap: &Wrap<models::Boxed<models::Holder>>,
    status: &Wrap<models::Status>,
    event: &Event<String>,
) {}
