{
	"name": "site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"rebuild": "pnpm run rebuild:plugin && pnpm run build",
		"rebuild:plugin": "pnpm --filter rustier build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"monaco-editor-core": "0.57.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"rustier": "workspace:*",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/assets/*": "./src/lib/assets/*",
		"#lib/*.svelte": "./src/lib/*.svelte",
		"#lib/ui/components/*": "./src/lib/ui/components/*/index.ts",
		"#lib/*": "./src/lib/*.ts"
	},
	"dependencies": {
		"@fontsource/anonymous-pro": "^5.3.0",
		"@jridgewell/trace-mapping": "^0.3.31",
		"@shikijs/monaco": "^4.5.0",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"monaco-editor": "^0.57.0",
		"shiki": "^4.5.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1"
	}
}
