{
	"name": "site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm build && vite preview",
		"prepare": "svelte-kit sync",
		"check": "pnpm run --parallel \"/^check\\//\"",
		"check/svelte": "node scripts/check-svelte.mjs",
		"check/lint": "eslint . --fix",
		"check/format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/assets/*": "./src/lib/assets/*",
		"#lib/*.svelte": "./src/lib/*.svelte",
		"#lib/*.svelte.ts": "./src/lib/*.svelte.ts",
		"#lib/ui/components/*": "./src/lib/ui/components/*/index.ts",
		"#lib/*": "./src/lib/*.ts"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-rust": "^6.0.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.14",
		"@lezer/highlight": "^1.2.5",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"paneforge": "^1.0.2",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1"
	}
}
