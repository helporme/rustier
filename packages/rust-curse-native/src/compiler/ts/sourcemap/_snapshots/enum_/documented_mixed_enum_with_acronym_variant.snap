## Source

```rs
let db = test_db! {
    pub struct Local; #[doc = r" A shape represented by several layouts."] pub enum
    Shape { #[doc = r" An acronym-prefixed request."] HTTPRequest { #[doc =
    r" A field name repeated by the next variant."] response_code : i32, }, #[doc =
    r" A title-cased request with the same generated tag."] HttpRequest { #[doc =
    r" A repeated field name."] response_code : i32, }, #[doc =
    r" Coordinates represented by tuple fields."] Point(#[doc =
    r" A Rust-backed value that cannot be replaced."] Local, i32,), #[doc =
    r" A variant without fields."] Unit, }
};
compile_test_enum(db, "Shape", 4)
```

