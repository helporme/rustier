## Source

```rs
let mut db = test_db! {
    @ file : "models.rs"; pub mod models { #[derive(Clone)] pub struct ExternalPoint;
    } #[derive(Clone)] pub struct Point { pub x : f64, pub y : f64, } pub struct
    Readonly; pub enum Example { First { value : models::ExternalPoint, mixed :
    Point, locked : Readonly, }, Second { value : String, mixed : Readonly, locked :
    Readonly, }, Third, }
};
JsCodegenPaths::set(&mut db, "path/to/bindings".to_owned());
compile_test_enum(&db, "Example")
```

