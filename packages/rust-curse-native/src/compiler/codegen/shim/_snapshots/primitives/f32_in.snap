# Compiled
## Node
```rust
fn cast(input: ()) {
    let output = ({
        let value = input;
        (if value.get_type().map_err(|err| napi::Error::from_reason(err.reason))?
            == ValueType::Number
        {
            unsafe { value.cast::<f64>() }
                .map_err(|_| napi::Error::from_reason(
                    "cannot cast value to f64".to_string(),
                ))
        } else {
            Err(napi::Error::from_reason("cannot cast value to f64".to_string()))
        })?
    }) as f32;
    consume(output);
}
```

## Wasm
