fn cast(input: ()) {
    let mut __cast_owned_value = {
        let type_name = "i16";
        let value = {
            let value = input;
            (value
                .as_f64()
                .ok_or_else(|| JsValue::from_str(
                    &"cannot cast value to f64".to_string(),
                )))?
        };
        if value.trunc() != value || value < i16::MIN as f64 || value > i16::MAX as f64 {
            return Err(
                JsValue::from_str(&format!("cannot cast {value} to {type_name}")),
            );
        }
        value as i16
    };
    let output = &mut __cast_owned_value;
    consume(output);
}
