fn cast(input: ()) {
    let mut __cast_owned_value = {
        let type_name = "i16";
        let value = {
            let value = input;
            (if value.get_type().map_err(|err| napi::Error::from_reason(err.reason))?
                == ValueType::Number
            {
                unsafe { value.cast::<f64>() }
                    .map_err(|_| napi::Error::from_reason(
                        "cannot cast value to f64".to_string(),
                    ))
            } else {
                Err(napi::Error::from_reason("cannot cast value to f64".to_string()))
            })?
        };
        if value.trunc() != value || value < i16::MIN as f64 || value > i16::MAX as f64 {
            return Err(
                napi::Error::from_reason(format!("cannot cast {value} to {type_name}")),
            );
        }
        value as i16
    };
    let output = &mut __cast_owned_value;
    consume(output);
}
```

