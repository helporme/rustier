# Compiled
## Node
```rust
fn cast(input: ()) {
    let output = {
        let value = {
            let type_name = "u32";
            let value = {
                let value = input;
                (if value.get_type().map_err(|err| napi::Error::from_reason(err.reason))?
                    == ValueType::Number
                {
                    unsafe { value.cast::<f64>() }
                        .map_err(|_| napi::Error::from_reason(
                            "cannot cast value to f64".to_string(),
                        ))
                } else {
                    Err(napi::Error::from_reason("cannot cast value to f64".to_string()))
                })?
            };
            if value.trunc() != value || value < 0 as f64 || value > u32::MAX as f64 {
                return Err(
                    napi::Error::from_reason(
                        format!("cannot cast {value} to {type_name}"),
                    ),
                );
            }
            value as u32
        };
        char::from_u32(value)
            .ok_or_else(|| napi::Error::from_reason(
                format!("cannot cast {value} to char"),
            ))?
    };
    consume(output);
}
```

