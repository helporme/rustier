fn cast(input: ()) {
    let output = {
        let value = {
            let type_name = "u32";
            let value = {
                let value = input;
                (value
                    .as_f64()
                    .ok_or_else(|| JsValue::from_str(
                        &"cannot cast value to f64".to_string(),
                    )))?
            };
            if value.trunc() != value || value < 0 as f64 || value > u32::MAX as f64 {
                return Err(
                    JsValue::from_str(&format!("cannot cast {value} to {type_name}")),
                );
            }
            value as u32
        };
        char::from_u32(value)
            .ok_or_else(|| JsValue::from_str(&format!("cannot cast {value} to char")))?
    };
    consume(output);
}
