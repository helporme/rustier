# Compiled
## Node
```rust
fn cast(input: ()) {
    let mut __cast_owned_value = {
        let value = input;
        (if value.get_type().map_err(|err| napi::Error::from_reason(err.reason))?
            == ValueType::String
        {
            unsafe { value.cast::<String>() }
                .map_err(|_| napi::Error::from_reason(
                    "cannot cast value to String".to_string(),
                ))
        } else {
            Err(napi::Error::from_reason("cannot cast value to String".to_string()))
        })?
    };
    let output = &__cast_owned_value;
    consume(output);
}
```

