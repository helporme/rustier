fn cast(input: ()) {
    let mut __cast_owned_value = {
        let value = input;
        (value
            .as_string()
            .ok_or_else(|| JsValue::from_str(
                &"cannot cast value to String".to_string(),
            )))?
    };
    let output = &__cast_owned_value;
    consume(output);
}
