# Source

```rust
///A generic wrapper.
#[derive(Clone)]
pub struct Wrap<T>(pub T);
impl<T> Wrap<T> {
    ///Constructs a wrapper.
    pub fn new(value: T) -> Self {
        Self(value)
    }
    pub fn identity(value: T) -> T {
        value
    }
}
impl Wrap<u32> {
    pub fn number_only(&self) -> bool {
        true
    }
}
pub fn consume(number: &Wrap<u32>, string: &Wrap<String>, nested: &Wrap<Wrap<u32>>) {}
```

