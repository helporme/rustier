    #[derive(Clone)] pub struct Local; @ file : "models.rs"; pub mod models {
    #[derive(Clone)] pub struct External; } #[doc =
    r" Accepts primitive, local, and external values."] pub fn foo(number : i32, text
    : String, local : Local, external : models::External) {}
};
compile_test_fn(db)
