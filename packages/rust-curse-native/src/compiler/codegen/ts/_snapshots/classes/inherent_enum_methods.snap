# Source

```rust
#[derive(Clone)]
pub enum Test {
    First,
    Second,
}
impl Test {
    /// Creates the first variant.
    pub fn first() -> Self {
        Self::First
    }
    pub fn is_first(&self) -> bool {
        matches!(self, Self::First)
    }
    pub fn make_second(&mut self) {
        *self = Self::Second;
    }
    pub fn into_bool(self) -> bool {
        matches!(self, Self::First)
    }
}
```

