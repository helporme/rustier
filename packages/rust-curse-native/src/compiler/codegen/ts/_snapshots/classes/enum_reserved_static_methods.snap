pub enum Wave {
    Sine(f32),
    Square(f32, f32),
    Triangle(f32, f32),
}
impl Wave {
    /// Creates a sine wave.
    pub fn new() -> Self {
        Self::Sine(1.0)
    }
    pub fn static_fn() -> u32 {
        0
    }
    pub fn r#default() -> Self {
        Self::new()
    }
    pub fn method_fn(&self) -> u32 {
        0
    }
}
