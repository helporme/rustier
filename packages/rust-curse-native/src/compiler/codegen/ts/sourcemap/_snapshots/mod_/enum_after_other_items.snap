## Test

```text
compiler::codegen::ts::sourcemap::mod_::tests::enum_after_other_items
```

## Source

```rs
let db = test_db! {
    #![doc = r" Module documentation before generated imports and declarations."] @
    file : "models.rs"; pub mod models { #[derive(Clone)] pub struct External; } pub
    fn before() {} pub struct Value { pub number : i32, } #[doc =
    r" The first choice emitted after functions and structs."] pub enum FirstChoice {
    Imported { external : models::External }, } #[doc =
    r" The second choice preserves enum declaration order."] pub enum SecondChoice {
    Empty {}, }
};
compile_test_mod(db, "")
```

