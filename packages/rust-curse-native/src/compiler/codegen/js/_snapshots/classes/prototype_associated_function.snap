export class Test {
	static #_construction_token = Symbol();
	#_ffi;



	constructor(
		token
	){
		if(
			token !== Test.#_construction_token
		){
			throw new TypeError(
				"rust-backed structs cannot be constructed directly (yet)"
			);
		}
	}

	static $from_ffi(
		ffi
	){
		const obj = new Test(
			 Test.#_construction_token
		);
		obj.#_ffi = ffi;
		return obj;
	}

	$ffi(){
		return this.#_ffi;
	}
}
