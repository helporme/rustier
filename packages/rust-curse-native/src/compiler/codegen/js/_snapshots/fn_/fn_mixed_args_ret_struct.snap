## Source

```rs
let db = test_db! {
    @ file : "parent.rs"; pub mod parent { #[derive(Clone)] pub struct Foo; } pub fn
    foo(a : i32, b : String, c : parent::Foo) -> parent::Foo { parent::Foo }
};
compile_test_fn(db)
```

## Output

```js
import {
	Foo
} from './parent.rs';

import {
	__ext_rustdoc_0test_0crate_foo
} from 'path/to/bindings';

export function foo (
	a,
	b,
	c
) {
	a = a;
	b = b;
	{
		const __facade_value = c;
		if(
			!(
				 __facade_value instanceof Foo
			)
		) {
			throw new TypeError(
				"Expected a value of type \"Foo\", but value of type \"" + typeof __facade_value + "\" was passed: \"" + String(
					__facade_value
				) + "\""
			);
		}
		c = __facade_value.__get_binding();
	}

	let result;
	result = Foo.__from_binding(
		__ext_rustdoc_0test_0crate_foo(
			a,
			b,
			c
		)
	);
	return result;
}
