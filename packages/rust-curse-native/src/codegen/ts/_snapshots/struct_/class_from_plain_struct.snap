	/** A numeric value. */
	public number: number;
	/** A text value. */
	public text: string;
	/** A value declared in the same module. */
	public readonly local: Local;
	/** A value imported from another module. */
	public readonly external: External;
	private __rust_curse_brand: never;
	private constructor();
}
