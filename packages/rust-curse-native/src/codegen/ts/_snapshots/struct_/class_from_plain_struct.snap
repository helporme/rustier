## Source

```rs
let db = test_db! {
    @ file : "models.rs"; pub mod models { pub struct External; } pub struct Local;
    #[doc = r" Stores primitive, local, and external values."] pub struct Foo { #[doc
    = r" A numeric value."] pub number : i32, #[doc = r" A text value."] pub text :
    String, #[doc = r" A value declared in the same module."] pub local : Local,
    #[doc = r" A value imported from another module."] pub external :
    models::External, }
};
compile_test_struct(&db, "Foo")
```

