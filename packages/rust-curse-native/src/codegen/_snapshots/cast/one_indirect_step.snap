## Source

```rs
HappyCastGraph::compile_cast(
        &db,
        Cast {
            from,
            to,
            in_expr: frag!(source()),
            out_var_name: "out",
        },
        frag!(consume(out);),
    )
    .print()
```

## Output

```rs
let value = source();
{
	let value = indirect(
		value
	);
	let out = value;
	consume(
		out
	);
}
