let db = test_db! {
    @ file : "models.rs"; pub mod models { #[derive(Clone)] pub struct External; }
    #[derive(Clone)] pub struct Local; pub struct Mixed { pub number : i32, pub text
    : String, pub local : Local, pub external : models::External, } pub fn
    mixed(number : i32, text : String, local : Local, external : models::External,)
    -> models::External { models::External }
};
compile_test_mod(db)
```

