## Test

```text
codegen::js::struct_::tests::class_from_tuple_struct
```

## Source

```rs
let mut db = test_db! {
    #[derive(Clone)] pub struct Baz {} pub struct Qux {} #[derive(Clone)] pub struct
    Foo(pub Baz, pub Qux, pub String);
};
JsCodegenPaths::set(&mut db, "path/to/bindings".to_owned());
compile_test_struct(&db, "Foo")
```

## Output

```js


export class Foo {
	#_binding;
	#_construction_token = Symbol();
	#_0;
	#_1;

	get [0](){
		return this.#_0;
	}

	set [0](
		value
	){
		this.#_binding[0] = value.__get_binding();
		this.#_0 = Baz.__from_binding(
			this.#_binding[0]
		);
	}

	get [1](){
		return this.#_1;
	}

	get [2](){
		return this.#_binding[2];
	}

	set [2](
		value
	){
		this.#_binding[2] = value;
	}

	constructor(
		token
	){
		if(
			token !== Foo.#_construction_token
		){
			throw new TypeError(
				"Rust-backed structs cannot be constructed directly"
			);
		}
	}

	static __from_binding(
		binding
	){
		const obj = new Foo(
			 Foo.#_construction_token
		);
		obj.#_binding = binding;
		obj.#_0 = Baz.__from_binding(
			binding[0]
		);
		obj.#_1 = Qux.__from_binding(
			binding[1]
		);
		return obj;
	}

	__get_binding(){
		return this.#_binding;
	}
}
```
