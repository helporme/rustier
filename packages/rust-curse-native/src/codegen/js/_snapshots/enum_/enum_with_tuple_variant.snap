## Test

```text
codegen::js::enum_::tests::enum_with_tuple_variant
```

## Source

```rs
let mut db = test_db! {
    #[derive(Clone)] pub struct Point { pub x : f64, pub y : f64, } pub enum Example
    { Tuple(Point, String, i32), }
};
JsCodegenPaths::set(&mut db, "path/to/bindings".to_owned());
compile_test_enum(&db, "Example")
```

## Output

```js


export class Example {
	static #_types =["tuple"];
	static #_construction_token = Symbol();
	#_binding;
	#_Tuple_0;

	get type() {
		return Example.#_types[this.#_binding.__type()];
	}

	get [0](){
		const binding = this.#_binding["__Tuple__0"];
		if(
			this.#_Tuple_0 === undefined || this.#_Tuple_0 === null
		) {
			this.#_Tuple_0 = Point.__from_binding(
				binding
			);
		}
		return this.#_Tuple_0;
	}

	set [0](
		value
	){
		{
			const __facade_value = value;
			if(
				!(
					 __facade_value instanceof Point
				)
			) {
				throw new TypeError(
					"Expected a value of type \"Point\", but value of type \"" + typeof __facade_value + "\" was passed: \"" + String(
						__facade_value
					) + "\""
				);
			}
			this.#_binding["__Tuple__0"] = __facade_value.__get_binding();
		}
		this.#_Tuple_0 = Point.__from_binding(
			this.#_binding["__Tuple__0"]
		);
	}

	get [1](){
		let value;
		value = this.#_binding["__Tuple__1"];
		return value;
	}

	set [1](
		value
	){
		this.#_binding["__Tuple__1"] = value;
	}

	get [2](){
		let value;
		value = this.#_binding["__Tuple__2"];
		return value;
	}

	set [2](
		value
	){
		this.#_binding["__Tuple__2"] = value;
	}

	constructor(
		token
	) {
		if(
			token !== Example.#_construction_token
		) {
			throw new TypeError(
				"Rust-backed enums cannot be constructed directly"
			);
		}
	}

	static __from_binding(
		binding
	) {
		const obj = new Example(
			 Example.#_construction_token
		);
		obj.#_binding = binding;
		return obj;
	}

	__get_binding() {
		return this.#_binding;
	}
}
