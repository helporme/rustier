## Source

```rs
let mut db = test_db! {
    pub enum Empty {}
};
JsCodegenPaths::set(&mut db, "path/to/bindings".to_owned());
compile_test_enum(&db, "Empty")
```

## Output

```js


export class Empty {
	static #_types =[];
	static #_construction_token = Symbol();
	#_binding;

	get type() {
		return Empty.#_types[this.#_binding.__type()];
	}



	constructor(
		token
	) {
		if(
			token !== Empty.#_construction_token
		) {
			throw new TypeError(
				"Rust-backed enums cannot be constructed directly"
			);
		}
	}

	static __from_binding(
		binding
	) {
		const obj = new Empty(
			 Empty.#_construction_token
		);
		obj.#_binding = binding;
		return obj;
	}

	__get_binding() {
		return this.#_binding;
	}
}
```
