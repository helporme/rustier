		const binding = this.#_binding["__Struct__point"];
		if(
			this.#_Struct_point === undefined || this.#_Struct_point === null
		) {
			this.#_Struct_point = Point.__from_binding(
				binding
			);
		}
		return this.#_Struct_point;
	}

	set ["point"](
		value
	){
		{
			const __facade_value = value;
			if(
				!(
					 __facade_value instanceof Point
				)
			) {
				throw new TypeError(
					"Expected a value of type \"Point\", but value of type \"" + typeof __facade_value + "\" was passed: \"" + String(
						__facade_value
					) + "\""
				);
			}
			this.#_binding["__Struct__point"] = __facade_value.__get_binding();
		}
		this.#_Struct_point = Point.__from_binding(
			this.#_binding["__Struct__point"]
		);
	}

	get ["label"](){
		let value;
		value = this.#_binding["__Struct__label"];
		return value;
	}

	set ["label"](
