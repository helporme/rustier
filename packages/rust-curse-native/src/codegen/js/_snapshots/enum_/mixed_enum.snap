	}

	get ["count"](){
		let value;
		value = this.#_binding["__Struct__count"];
		return value;
	}

	set ["count"](
		value
	){
		this.#_binding["__Struct__count"] = value;
	}

	constructor(
		token
	) {
		if(
			token !== Example.#_construction_token
		) {
			throw new TypeError(
				"Rust-backed enums cannot be constructed directly"
			);
		}
	}

	static __from_binding(
		binding
	) {
		const obj = new Example(
