---
source: src/codegen/bindings/enum_.rs
expression: body
---
## Test

```text
codegen::bindings::enum_::tests::compiles_mixed_enum
```

## Source

```rs
let mut db = test_db! {
    #[derive(Clone)] pub struct Point { pub x : f64, pub y : f64, } pub enum Example
    { Unit, Tuple(Point, String, i32), Struct { point : Point, label : String, count
    : i32, }, }
};
Api::set(&mut db, ApiKind::Node);
let enum_ = lower_enum(&db, db.rustdoc_id("Example")).unwrap();
let node = compile_binding_enum(&db, enum_).to_string();
syn::parse_file(&node)
    .expect("generated Node enum bindings must be valid Rust syntax");
Api::set(
    &mut db,
    ApiKind::Wasm {
        target: WasmTarget::Web,
    },
);
let enum_ = lower_enum(&db, db.rustdoc_id("Example")).unwrap();
let wasm = compile_binding_enum(&db, enum_).to_string();
syn::parse_file(&wasm)
    .expect("generated Wasm enum bindings must be valid Rust syntax");
("// Node\n", node, "\n\n// Wasm\n", wasm).print()
```

