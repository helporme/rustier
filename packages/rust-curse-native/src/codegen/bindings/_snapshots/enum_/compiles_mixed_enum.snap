						"Expected Rust `i32` from a JavaScript number: {}", err
					)
				)
			)?;
			result.write(
				value
			);
			unsafe {
				result.assume_init()
			}
		};
		self.src.set_Struct__count(
			value
		)?;Ok(
			()
		)
	}
}
```
