## Source

```rs
let from = SourceType {
    value: Type::String,
    mode: PassMode::Owned,
};
let to = SourceType {
    value: Type::Str,
    mode: PassMode::Ref,
};
snapshot_for_apis(|db| {
    DirectCastRule::compile(CastStringToStrRefRule, db, from, to, "input").print()
})
```

