## Source

```rs
let from = SourceType::i32;
let to = BoundaryType::i32;
snapshot_for_apis(|db| {
    DirectCastRule::compile(
            CastPrimitiveToSameBoundaryRule,
            db,
            from.clone(),
            to.clone(),
            "input",
        )
        .print()
})
```

