## Test

```text
codegen::bindings::primitive::tests::casts_boundary_js_type_to_f64
```

## Source

```rs
let from = BoundaryType::JsAny;
let to = SourceType {
    value: Type::Primitive(Primitive::f64),
    mode: PassMode::Owned,
};
snapshot_for_apis(|db| {
    DirectCastRule::compile(CastJsAnyToF64Rule, db, from, to, "input").print()
})
```

## Output

```rs
// Node
{
	let value = input;
	(
		if value.get_type().map_err(
			|err| napi::Error::from_reason(
				err.reason
			)
		)? == ValueType::Number {
			unsafe {
				value.cast::<f64>()
			}.map_err(
				|_| napi::Error::from_reason(
					"cannot cast value to f64".to_string()
				)
			)
		}
		else {
			Err(
				napi::Error::from_reason(
					"cannot cast value to f64".to_string()
				)
			)
		}
	)?
}

// Wasm
{
	let value = input;
	(
		value.as_f64().ok_or_else(
			|| JsValue::from_str(
				&"cannot cast value to f64".to_string()
			)
		)
	)?
}
```
