## Test

```text
codegen::bindings::primitive::tests::casts_string_to_str_mut
```

## Source

```rs
let from = SourceType::String;
let to = SourceType::Ref {
    is_mutable: true,
    inner: Box::new(SourceType::Str),
};
snapshot_for_apis(|db| {
    IndirectCastRule::compile(
            CastStringToStrMutRule,
            db,
            from.clone(),
            to.clone(),
            "input",
            fragment(|p| "consume(value);".apply(p)),
        )
        .print()
})
```

## Output

```rs
// Node
{
	let mut value = input;
	let value = value.as_mut_str();
	consume(value);
}

// Wasm
{
	let mut value = input;
	let value = value.as_mut_str();
	consume(value);
}
```
