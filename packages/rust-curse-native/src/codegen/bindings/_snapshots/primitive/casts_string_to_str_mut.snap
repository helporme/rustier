## Test

```text
codegen::bindings::primitive::tests::casts_string_to_str_mut
```

## Source

```rs
let from = SourceType {
    value: Type::String,
    mode: PassMode::Owned,
};
let to = SourceType {
    value: Type::Str,
    mode: PassMode::Mut,
};
snapshot_for_apis(|db| {
    IndirectCastRule::compile(
            CastStringToStrMutRule,
            db,
            from,
            to,
            "input",
            fragment(|p| "consume(value);".apply(p)),
        )
        .print()
})
```

## Output

```rs
// Node
{
	let mut value = input;
	let value = value.as_mut_str();
	consume(value);
}

// Wasm
{
	let mut value = input;
	let value = value.as_mut_str();
	consume(value);
}
```
