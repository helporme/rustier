## Test

```text
codegen::bindings::primitive::tests::casts_boundary_js_type_to_bool
```

## Source

```rs
let from = BirBoundaryType::JsAny;
let to = BirSourceType::bool;
snapshot_for_apis(|db| {
    DirectCastRule::compile(
            CastJsAnyToBoolRule,
            db,
            from.clone(),
            to.clone(),
            "input",
        )
        .print()
})
```

## Output

```rs
// Node
{
	let value = input;
	(
		if value.get_type().map_err(
			|err| napi::Error::from_reason(
				err.reason
			)
		)? == ValueType::Boolean {
			unsafe {
				value.cast::<bool>()
			}.map_err(
				|_| napi::Error::from_reason(
					"cannot cast value to bool".to_string()
				)
			)
		}
		else {
			Err(
				napi::Error::from_reason(
					"cannot cast value to bool".to_string()
				)
			)
		}
	)?
}

// Wasm
{
	let value = input;
	(
		value.as_bool().ok_or_else(
			|| JsValue::from_str(
				&"cannot cast value to bool".to_string()
			)
		)
	)?
}
```
