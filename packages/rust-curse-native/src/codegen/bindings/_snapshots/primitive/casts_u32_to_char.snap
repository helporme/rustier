## Test

```text
codegen::bindings::primitive::tests::casts_u32_to_char
```

## Source

```rs
let from = BirSourceType::u32;
let to = BirSourceType::char;
snapshot_for_apis(|db| {
    DirectCastRule::compile(CastU32ToCharRule, db, from.clone(), to.clone(), "input")
        .print()
})
```

## Output

```rs
// Node
{
	let value = input;
	char::from_u32(
		value
	).ok_or_else(
		|| napi::Error::from_reason(
			format!(
				"cannot cast {value} to char"
			)
		)
	)?
}

// Wasm
{
	let value = input;
	char::from_u32(
		value
	).ok_or_else(
		|| JsValue::from_str(
			&format!(
				"cannot cast {value} to char"
			)
		)
	)?
}
```
