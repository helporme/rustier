codegen::bindings::primitive::tests::casts_char_to_u32_boundary
```

## Source

```rs
let from = BirSourceType::char;
let to = BirBoundaryType::u32;
snapshot_for_apis(|db| {
    DirectCastRule::compile(
            CastCharToU32BoundaryRule,
            db,
            from.clone(),
            to.clone(),
            "input",
        )
        .print()
})
```

