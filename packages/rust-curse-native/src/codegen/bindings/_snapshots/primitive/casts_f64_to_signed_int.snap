## Test

```text
codegen::bindings::primitive::tests::casts_f64_to_signed_int
```

## Source

```rs
let from = SourceType::f64;
let to = SourceType::i32;
snapshot_for_apis(|db| {
    DirectCastRule::compile(
            CastF64ToSignedIntRule,
            db,
            from.clone(),
            to.clone(),
            "input",
        )
        .print()
})
```

## Output

```rs
// Node
{
	let type_name = "i32";
	let value = input;
	if value.trunc() != value || value < i32::MIN as f64 || value > i32::MAX as f64 {
		return Err(
			napi::Error::from_reason(
				format!(
					"cannot cast {value} to {type_name}"
				)
			)
		);
	}
	value as i32
}

// Wasm
{
	let type_name = "i32";
	let value = input;
	if value.trunc() != value || value < i32::MIN as f64 || value > i32::MAX as f64 {
		return Err(
			JsValue::from_str(
				&format!(
					"cannot cast {value} to {type_name}"
				)
			)
		);
	}
	value as i32
}
```
