## Test

```text
codegen::bindings::tethering::tests::compiles_tethered_struct_cloned_field
```

## Source

```rs
let fields: [TetheredField<'_, &'static str, FieldExpr, FieldExpr>; 1] = [
    TetheredField::Cloned(ClonedField {
        name: "count",
        get_ref_expr: |source| frag!(Ok(& { source } .count)).print(),
        get_mut_expr: |source| frag!(Ok(& mut ~ { source } .count)).print(),
        source_type: "u32",
    }),
];
compile_tethered_struct(TetheringStruct {
        source_type: "crate::Parent",
        name: "__tethered_parent",
        fields,
    })
    .print()
```

## Output

```rs
struct __tethered_parent {
	src: __tethering::SourceSlot<crate::Parent>,
}

impl __tethering::Accessor<crate::Parent> for __tethered_parent {
	fn access(
		&self,
		f: &mut dyn FnMut(
			&crate::Parent
		)-> __tethering::AccessResult<()>,
	)-> __tethering::AccessResult<()> {
		self.src.access(
			f
		)
	}

	fn access_mut(
		&self,
		f: &mut dyn FnMut(
			&mut crate::Parent
		)-> __tethering::AccessResult<()>,
	)-> __tethering::AccessResult<()> {
		self.src.access_mut(
			f
		)
	}
}

impl __tethered_parent {
	pub fn new_owned(
		input: crate::Parent
	) -> Self {
		__tethered_parent {
			src: __tethering::SourceSlot::owned(
				input
			),
		}
	}

	pub fn new_projected(
		accessor: std::rc::Rc<dyn __tethering::Accessor<crate::Parent>>
	)-> Self {
		__tethered_parent {
			src: __tethering::SourceSlot::projected(
				accessor
			),
		}
	}

	pub fn get_count(
		&self
	)-> __tethering::AccessResult<u32> {
		let mut result = std::mem::MaybeUninit::uninit();
		self.access(
			&mut |src| {
				result.write(
					Ok(
						&src.count
					)?.clone()
				);
				Ok(
					()
				)
			}
		)?;
		Ok(
			unsafe {
				result.assume_init()
			}
		)
	}

	pub fn set_count(
		&self, value: u32
	)-> __tethering::AccessResult<()> {
		let mut value = Some(
			value
		);
		self.access_mut(
			&mut |src| {
				*Ok(
					&mut src.count
				)? = value.take().unwrap();
				Ok(
					()
				)
			}
		)?;
		Ok(
			()
		)
	}
}
