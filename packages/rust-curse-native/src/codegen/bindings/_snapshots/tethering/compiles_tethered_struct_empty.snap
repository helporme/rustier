## Test

```text
codegen::bindings::tethering::tests::compiles_tethered_struct_empty
```

## Source

```rs
let fields: [TetheredField<'_, &'static str, FieldExpr, FieldExpr>; 0] = [];
compile_tethered_struct(TetheredStruct {
        source_type: "crate::Empty",
        name: "__tethered_empty",
        fields,
    })
    .print()
```

## Output

```rs
struct __tethered_empty {
	src: __tethering::SourceSlot<crate::Empty>,
}

impl __tethering::Accessor<crate::Empty> for __tethered_empty {
	fn access(
		&self,
		f: &mut dyn FnMut(
			&crate::Empty
		)-> __tethering::AccessResult<()>,
	)-> __tethering::AccessResult<()> {
		self.src.access(
			f
		)
	}

	fn access_mut(
		&self,
		f: &mut dyn FnMut(
			&mut crate::Empty
		)-> __tethering::AccessResult<()>,
	)-> __tethering::AccessResult<()> {
		self.src.access_mut(
			f
		)
	}
}

impl __tethered_empty {
	pub fn new_owned(
		input: crate::Empty
	) -> Self {
		__tethered_empty {
			src: __tethering::SourceSlot::owned(
				input
			),
		}
	}

	pub fn new_projected(
		accessor: std::rc::Rc<dyn __tethering::Accessor<crate::Empty>>
	)-> Self {
		__tethered_empty {
			src: __tethering::SourceSlot::projected(
				accessor
			),
		}
	}

}
