## Test

```text
codegen::bindings::tethering::tests::compiles_tethered_struct_empty
```

## Source

```rs
let db = test_db! {
    pub struct Empty;
};
let fields: [TetheredField<'_, FieldExpr, FieldExpr>; 0] = [];
compile_tethering_struct(
        &db,
        TetheringStruct {
            source_type: BirSourceType::Item {
                target: db.item_id("Empty"),
            },
            fields,
        },
    )
    .print()
```

