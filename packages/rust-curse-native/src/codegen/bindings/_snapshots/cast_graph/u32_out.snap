fn cast(input: ()) {
    let output = ({
        let value = input;
        char::from_u32(value)
            .ok_or_else(|| napi::Error::from_reason(
                format!("cannot cast {value} to char"),
            ))?
    }) as u32;
    consume(output);
}
```

