fn cast(input: ()) {
    let mut __cast_owned_value = ({
        let value = input;
        (value
            .as_f64()
            .ok_or_else(|| JsValue::from_str(&"cannot cast value to f64".to_string())))?
    }) as f32;
    let output = &__cast_owned_value;
    consume(output);
}
