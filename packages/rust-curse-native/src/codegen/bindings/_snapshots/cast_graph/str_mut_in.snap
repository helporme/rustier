fn cast(input: ()) {
    {
        let mut value = {
            let value = input;
            (value
                .as_string()
                .ok_or_else(|| JsValue::from_str(
                    &"cannot cast value to String".to_string(),
                )))?
        };
        let value = value.as_mut_str();
        let output = value;
        consume(output);
    }
}
