## Test

```text
codegen::bindings::cast::tests::compiles_bool_cast_fn
```

## Source

```rs
let mut db = DbImpl::default();
Api::set(&mut db, ApiKind::Node);
let node = compile_cast_fn(&db, Type::Primitive(Primitive::Boolean)).print();
syn::parse_file(&node)
    .expect("generated Node cast function must be valid Rust syntax");
Api::set(
    &mut db,
    ApiKind::Wasm {
        target: WasmTarget::Web,
    },
);
let wasm = compile_cast_fn(&db, Type::Primitive(Primitive::Boolean)).print();
syn::parse_file(&wasm)
    .expect("generated Wasm cast function must be valid Rust syntax");
("// Node\n", node, "\n\n// Wasm\n", wasm).print()
```

## Output

```rs
// Node
fn __cast_bool(
	value: Unknown<'_>
)-> Result<bool, String> {
	if value.get_type().map_err(
		|err| err.reason
	)? == ValueType::Boolean {
		unsafe {
			value.cast::<bool>()
		}.map_err(
			|_| "cannot cast value to bool".to_string()
		)
	}
	else {
		Err(
			"cannot cast value to bool".to_string()
		)
	}
}

// Wasm
fn __cast_bool(
	value: JsValue
)-> Result<bool, String> {
	value.as_bool().ok_or_else(
		|| "cannot cast value to bool".to_string()
	)
}
```
