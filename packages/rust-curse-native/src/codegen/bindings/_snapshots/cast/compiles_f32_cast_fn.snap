## Test

```text
codegen::bindings::cast::tests::compiles_f32_cast_fn
```

## Source

```rs
let mut db = DbImpl::default();
Api::set(&mut db, ApiKind::Node);
let node = compile_cast_fn(&db, Type::Primitive(Primitive::f32)).print();
syn::parse_file(&node)
    .expect("generated Node cast function must be valid Rust syntax");
Api::set(
    &mut db,
    ApiKind::Wasm {
        target: WasmTarget::Web,
    },
);
let wasm = compile_cast_fn(&db, Type::Primitive(Primitive::f32)).print();
syn::parse_file(&wasm)
    .expect("generated Wasm cast function must be valid Rust syntax");
("// Node\n", node, "\n\n// Wasm\n", wasm).print()
```

## Output

```rs
// Node
fn __cast_f32(
	value: Unknown<'_>
)-> Result<f32, String> {
	let type_name = "f32";
	let value = __cast_f64(
		value
	).map_err(
		|_| format!(
			"cannot cast value to {type_name}"
		)
	)?;
	Ok(
		value as f32
	)
}

// Wasm
fn __cast_f32(
	value: JsValue
)-> Result<f32, String> {
	let type_name = "f32";
	let value = __cast_f64(
		value
	).map_err(
		|_| format!(
			"cannot cast value to {type_name}"
		)
	)?;
	Ok(
		value as f32
	)
}
```
