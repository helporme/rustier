## Test

```text
codegen::bindings::cast::tests::compiles_char_cast_fn
```

## Source

```rs
let mut db = DbImpl::default();
Api::set(&mut db, ApiKind::Node);
let node = compile_cast_fn(&db, Type::Primitive(Primitive::Char)).print();
syn::parse_file(&node)
    .expect("generated Node cast function must be valid Rust syntax");
Api::set(
    &mut db,
    ApiKind::Wasm {
        target: WasmTarget::Web,
    },
);
let wasm = compile_cast_fn(&db, Type::Primitive(Primitive::Char)).print();
syn::parse_file(&wasm)
    .expect("generated Wasm cast function must be valid Rust syntax");
("// Node\n", node, "\n\n// Wasm\n", wasm).print()
```

## Output

```rs
// Node
fn __cast_char(
	value: Unknown<'_>
)-> Result<char, String> {
	let value = __cast_u32(
		value
	).map_err(
		|_| "cannot cast value to char".to_string()
	)?; char::from_u32(
		value
	).ok_or_else(
		|| format!(
			"cannot cast {value} to char"
		)
	)
}

// Wasm
fn __cast_char(
	value: JsValue
)-> Result<char, String> {
	let value = __cast_u32(
		value
	).map_err(
		|_| "cannot cast value to char".to_string()
	)?; char::from_u32(
		value
	).ok_or_else(
		|| format!(
			"cannot cast {value} to char"
		)
	)
}
```
