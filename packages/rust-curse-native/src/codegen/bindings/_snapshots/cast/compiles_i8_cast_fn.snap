## Test

```text
codegen::bindings::cast::tests::compiles_i8_cast_fn
```

## Source

```rs
let mut db = DbImpl::default();
Api::set(&mut db, ApiKind::Node);
let node = compile_cast_fn(&db, Type::Primitive(Primitive::i8)).print();
syn::parse_file(&node)
    .expect("generated Node cast function must be valid Rust syntax");
Api::set(
    &mut db,
    ApiKind::Wasm {
        target: WasmTarget::Web,
    },
);
let wasm = compile_cast_fn(&db, Type::Primitive(Primitive::i8)).print();
syn::parse_file(&wasm)
    .expect("generated Wasm cast function must be valid Rust syntax");
("// Node\n", node, "\n\n// Wasm\n", wasm).print()
```

## Output

```rs
// Node
fn __cast_i8(
	value: Unknown<'_>
)-> Result<i8, String> {
	let type_name = "i8";
	let value = __cast_f64(
		value
	).map_err(
		|_| format!(
			"cannot cast value to {type_name}"
		)
	)?;
	if value.trunc() != value || value < i8::MIN as f64 || value > i8::MAX as f64 {
		return Err(
			format!(
				"cannot cast {value} to {type_name}"
			)
		);
	}
	Ok(
		value as i8
	)
}

// Wasm
fn __cast_i8(
	value: JsValue
)-> Result<i8, String> {
	let type_name = "i8";
	let value = __cast_f64(
		value
	).map_err(
		|_| format!(
			"cannot cast value to {type_name}"
		)
	)?;
	if value.trunc() != value || value < i8::MIN as f64 || value > i8::MAX as f64 {
		return Err(
			format!(
				"cannot cast {value} to {type_name}"
			)
		);
	}
	Ok(
		value as i8
	)
}
```
