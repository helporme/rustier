```ts

// src/lib.rs.d.ts
export class Mesh {
    private [" "]: 'crate::Mesh';

    get x(): number;

    set x(value: number);

    private constructor();
}

export type Hitbox = Hitbox.Instance & Hitbox.Init;

export declare const Hitbox: {
    readonly prototype: Hitbox;
};

export declare namespace Hitbox {
    export interface Instance {
        readonly [" "]: 'crate::Hitbox';
        get mesh(): Mesh | undefined;
    }

    export type Init =
        | {
              readonly type: 'active';
              mesh: Mesh;
          }
        | {
              readonly type: 'disabled';
          };
}
