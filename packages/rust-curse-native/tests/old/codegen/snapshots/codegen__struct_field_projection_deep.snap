// src/lib.rs.d.ts
export class C {
    private [" "]: 'crate::C';

    get x(): number;

    set x(value: number);

    private constructor();

    static of(init: C.Init): C;
}

export namespace C {
    export type Init = {
        x: number;
    };
}

export class B {
    private [" "]: 'crate::B';

    get c(): C;

    set c(value: C | C.Init);

    private constructor();

    static of(init: B.Init): B;
}

export namespace B {
    export type Init = {
        c: C | C.Init;
    };
}

export class A {
    private [" "]: 'crate::A';

    get b(): B;

    set b(value: B | B.Init);

    private constructor();

    static of(init: A.Init): A;
}

export namespace A {
    export type Init = {
        b: B | B.Init;
    };
}
