// src/types.rs.d.ts
/** An authentication token. */
export class Token {
    private [" "]: 'crate::types::Token';

    /** The raw token string. */
    get value(): string;

    set value(value: string);

    private constructor();
}

// src/ops.rs.d.ts
import type { Token } from "./types.rs";

/** Parses a raw string into a Token. */
export function parse(s: string): Token;
