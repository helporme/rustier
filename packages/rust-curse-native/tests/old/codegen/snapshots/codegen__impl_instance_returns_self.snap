# Source

```rs
#[derive(Clone)]
pub struct Point {
    pub x: f64,
    pub y: f64,
}
impl Point {
    pub fn move_towards(&self, t: &Self, s: f64) -> Self {
        Self {
            x: self.x + (t.x - self.x) * s,
            y: self.y + (t.y - self.y) * s,
        }
    }
}
```

