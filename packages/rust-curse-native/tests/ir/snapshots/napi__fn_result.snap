#![allow(non_camel_case_types, non_snake_case)]
use napi_derive::napi;
/// `Result<T, E>` at return position becomes `napi::Result<T>`.
#[napi(js_name = "f")]
pub fn __cursed_rustdoc_test_crate__f(x: i32) -> napi::Result<String> {
    crate::f(x).map_err(|e| napi::Error::from_reason(format!("{e:?}")))
}
