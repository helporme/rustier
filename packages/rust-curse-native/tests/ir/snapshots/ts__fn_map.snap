declare module "$rust-curse" {
    export type Copy<T> = {
        [K in keyof T as T[K] extends
            | string | number | boolean | bigint
            | Record<string, unknown> | unknown[]
            ? K : never]: Copy<T[K]>;
    };
}

declare module "$rust/rustdoc_test_crate" {
    /** All maps become `Map<K, V>` regardless of key type. */
    export function f(a: Map<string, number>, b: Map<number, boolean>, c: Map<bigint, string>): void;
