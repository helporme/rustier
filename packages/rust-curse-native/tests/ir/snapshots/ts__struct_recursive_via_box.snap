declare module "$rust-curse" {
    export type Copy<T> = {
        [K in keyof T as T[K] extends
            | string | number | boolean | bigint
            | Record<string, unknown> | unknown[]
            ? K : never]: Copy<T[K]>;
    };
}

declare module "$rust/rustdoc_test_crate" {
    /** Self-referencing class must not emit a self-import. */
    export class Node {
        private [" "]!: 'rustdoc_test_crate::Node';

        next: Node | undefined;

        constructor(next: Node | undefined);
    }
}
