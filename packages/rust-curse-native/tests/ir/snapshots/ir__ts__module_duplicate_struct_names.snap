---
source: tests/ir/ts.rs
description: "pub mod a {\n    pub struct Thing {\n        pub x: i32,\n    }\n}\npub mod b {\n    pub struct Thing {\n        pub y: i32,\n    }\n}\n"
expression: ir.print_ts()
---
declare module "$rust-curse" {
    export type Copy<T> = {
        [K in keyof T as T[K] extends
            | string | number | boolean | bigint
            | Record<string, unknown> | unknown[]
            ? K : never]: Copy<T[K]>;
    };
}

declare module "$rust/rustdoc_test_crate/a" {
    export class Thing {
        private [" "]!: 'rustdoc_test_crate::a::Thing';

        x: number;

        constructor(x: number);
    }
}

declare module "$rust/rustdoc_test_crate/b" {
    export class Thing {
        private [" "]!: 'rustdoc_test_crate::b::Thing';

        y: number;

        constructor(y: number);
    }
}
