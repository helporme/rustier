/// Exercises every primitive type that maps to `number` or `string` or `boolean`.
pub fn f(
    a: i8,
    b: i16,
    c: i32,
    d: u8,
    e: u16,
    f: u32,
    g: f32,
    h: f64,
    i: bool,
    j: char,
    k: String,
    l: &str,
) {}
```

```ts
declare module "$rust-curse" {
    export type Copy<T> = {
        [K in keyof T as T[K] extends
            | string | number | boolean | bigint
            | Record<string, unknown> | unknown[]
            ? K : never]: Copy<T[K]>;
    };
}

// src/lib.rs.d.ts
/** Exercises every primitive type that maps to `number` or `string` or `boolean`. */
export function f(a: number, b: number, c: number, d: number, e: number, f: number, g: number, h: number, i: boolean, j: string, k: string, l: string): void;
