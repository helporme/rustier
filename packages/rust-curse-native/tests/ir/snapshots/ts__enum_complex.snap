declare module "$rust/rustdoc_test_crate" {
    /** A geometric shape with mixed variant kinds. */
    export type Shape =
        | {
            /** A circle defined by its radius. */
            type: 'Circle';
            radius: number;
        }
        | {
            /** An axis-aligned rectangle. */
