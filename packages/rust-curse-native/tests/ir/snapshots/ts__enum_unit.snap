declare module "$rust/rustdoc_test_crate" {
    /** Cardinal compass directions — all unit variants become a string union. */
    export type Direction =
        // Toward the top.
        | 'North'
        // Toward the bottom.
        | 'South'
        // Toward the right.
        | 'East'
        // Toward the left.
        | 'West';
