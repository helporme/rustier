#![allow(non_camel_case_types, non_snake_case)]
use napi_derive::napi;
use crate::Loader;
/// `new() -> Result<Self, _>` lifts to `napi::Result<Self>` on the ctor.
#[napi(js_name = "__cursed_rustdoc_test_crate__Loader__Ref")]
pub struct __cursed_rustdoc_test_crate__Loader__Ref {
    inner: Loader,
}
#[napi]
impl __cursed_rustdoc_test_crate__Loader__Ref {
    #[napi(constructor)]
    pub fn new(capacity: usize) -> napi::Result<Self> {
        Loader::new(capacity)
            .map(|inner| Self { inner })
            .map_err(|e| napi::Error::from_reason(format!("{e:?}")))
    }
}
impl From<Loader> for __cursed_rustdoc_test_crate__Loader__Ref {
    fn from(v: Loader) -> Self {
        Self { inner: v }
    }
}
impl From<__cursed_rustdoc_test_crate__Loader__Ref> for Loader {
    fn from(v: __cursed_rustdoc_test_crate__Loader__Ref) -> Self {
        v.inner
    }
}
