# Source

```rs
pub struct Counter {
    count: u32,
}
impl Counter {
    pub fn increment(&mut self) {
        self.count += 1;
    }
}
impl Counter {
    pub fn new(seed: u32) -> Self {
        Counter { count: seed }
    }
}
```

