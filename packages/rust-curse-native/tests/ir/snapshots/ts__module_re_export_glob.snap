---
source: tests/ir/ts.rs
description: "pub mod inner {\n    pub struct S {\n        pub x: i32,\n    }\n    pub enum E {\n        A,\n        B,\n    }\n    pub fn f() -> i32 {\n        0\n    }\n}\npub use inner::*;\n"
expression: ir.print_ts()
---
declare module "$rust-curse" {
    export type Copy<T> = {
        [K in keyof T as T[K] extends
            | string | number | boolean | bigint
            | Record<string, unknown> | unknown[]
            ? K : never]: Copy<T[K]>;
    };
}

declare module "$rust/rustdoc_test_crate" {
    export { S } from "$rust/rustdoc_test_crate/inner";

    export { E } from "$rust/rustdoc_test_crate/inner";

    export { f } from "$rust/rustdoc_test_crate/inner";
}

declare module "$rust/rustdoc_test_crate/inner" {
    export class S {
        private [" "]!: 'rustdoc_test_crate::inner::S';

        x: number;

        constructor(x: number);
    }

    export type E = 'A' | 'B';

    export function f(): number;
}
