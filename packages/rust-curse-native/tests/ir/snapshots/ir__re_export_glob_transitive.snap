use wasm_bindgen::prelude::*;
#[wasm_bindgen(js_name = "__cursed_rustdoc_test_crate__deeper__X")]
pub struct __cursed_rustdoc_test_crate__deeper__X {
    inner: crate::deeper::X,
}
#[wasm_bindgen]
impl __cursed_rustdoc_test_crate__deeper__X {
    #[wasm_bindgen(constructor)]
    pub fn new(x: i32) -> Self {
        Self {
            inner: crate::deeper::X { x },
        }
    }
    #[wasm_bindgen(getter, js_name = "x")]
    pub fn x(&self) -> i32 {
        self.inner.x
    }
    #[wasm_bindgen(setter, js_name = "x")]
    pub fn set_x(&mut self, v: i32) {
        self.inner.x = v;
    }
}
impl From<crate::deeper::X> for __cursed_rustdoc_test_crate__deeper__X {
    fn from(v: crate::deeper::X) -> Self {
        Self { inner: v }
    }
}
impl From<__cursed_rustdoc_test_crate__deeper__X> for crate::deeper::X {
    fn from(v: __cursed_rustdoc_test_crate__deeper__X) -> Self {
        v.inner
    }
}
