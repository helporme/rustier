---
source: tests/ir/ts.rs
description: "/// `new()` in a trait impl is recognised as an explicit constructor. The `seed`\n/// param name differs from the field `x` so the snapshot proves the trait-impl\n/// ctor is picked up rather than synthesised from the struct's fields.\npub trait Factory {\n    fn new(seed: u32) -> Self;\n}\npub struct Foo {\n    x: i32,\n}\nimpl Factory for Foo {\n    fn new(seed: u32) -> Self {\n        Foo { x: seed as i32 }\n    }\n}\n"
expression: out
---
declare module "$rust-curse" {
    export type Copy<T> = {
        [K in keyof T as T[K] extends
            | string | number | boolean | bigint
            | Record<string, unknown> | unknown[]
            ? K : never]: Copy<T[K]>;
    };
}

// src/lib.d.rs.ts
export class Foo {
    private [" "]: 'rustdoc_test_crate::Foo';

    constructor(seed: number);
}
