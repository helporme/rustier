/// Every primitive type passes straight through to a napi-native type.
pub fn f(
    a: i8,
    b: i16,
    c: i32,
    d: u8,
    e: u16,
    f: u32,
    g: f32,
    h: f64,
    i: bool,
    j: char,
    k: String,
    l: &str,
) {}
```

```rs
use napi_derive::napi;
/// Every primitive type passes straight through to a napi-native type.
#[napi(js_name = "__cursed_rustdoc_test_crate__f")]
pub fn __cursed_rustdoc_test_crate__f(
    a: i8,
    b: i16,
    c: i32,
    d: u8,
    e: u16,
    f: u32,
    g: f32,
    h: f64,
    i: bool,
    j: char,
    k: String,
    l: String,
) {
    crate::f(a, b, c, d, e, f, g, h, i, j, k, &l);
}
```
