---
source: tests/ir/ts.rs
description: "pub struct Point {\n    pub x: i32,\n    pub y: i32,\n}\n/// Mixes a tuple-with-nominal variant and a unit variant.\npub enum Msg {\n    Move(Point),\n    Stop,\n}\n"
expression: ir.print_ts()
---
declare module "$rust-curse" {
    export type Copy<T> = {
        [K in keyof T as T[K] extends
            | string | number | boolean | bigint
            | Record<string, unknown> | unknown[]
            ? K : never]: Copy<T[K]>;
    };
}

declare module "$rust/rustdoc_test_crate" {
    export class Point {
        private [" "]!: 'rustdoc_test_crate::Point';

        x: number;

        y: number;

        constructor(x: number, y: number);
    }

    /** Mixes a tuple-with-nominal variant and a unit variant. */
    export type Msg =
        | {
            type: 'Move';
            0: Point;
        }
        | {
            type: 'Stop';
        };
}
