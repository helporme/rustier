---
source: tests/ir/ts.rs
description: "/// `new() -> Result<Self, _>` is recognised as an explicit constructor. The\n/// `capacity` param name differs from the field `data`, so the snapshot proves\n/// the ctor is picked up rather than synthesised from the struct's fields.\npub struct Loader {\n    data: Vec<u8>,\n}\nimpl Loader {\n    pub fn new(capacity: usize) -> Result<Self, String> {\n        Ok(Self {\n            data: Vec::with_capacity(capacity),\n        })\n    }\n}\n"
expression: ir.print_ts()
---
declare module "$rust-curse" {
    export type Copy<T> = {
        [K in keyof T as T[K] extends
            | string | number | boolean | bigint
            | Record<string, unknown> | unknown[]
            ? K : never]: Copy<T[K]>;
    };
}

declare module "$rust/rustdoc_test_crate" {
    /**
     * `new() -> Result<Self, _>` is recognised as an explicit constructor. The
     * `capacity` param name differs from the field `data`, so the snapshot proves
     * the ctor is picked up rather than synthesised from the struct's fields.
     */
    export class Loader {
        private [" "]!: 'rustdoc_test_crate::Loader';

        constructor(capacity: bigint);
    }
}
