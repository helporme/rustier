expression: ir.print_ts()
---
declare module "$rust-curse" {
    export type Copy<T> = {
        [K in keyof T as T[K] extends
            | string | number | boolean | bigint
            | Record<string, unknown> | unknown[]
            ? K : never]: Copy<T[K]>;
    };
}

declare module "$rust/rustdoc_test_crate" {
    /** Both classes live in the same module, so neither should be imported. */
    export class A {
        private [" "]!: 'rustdoc_test_crate::A';

        constructor();
    }

    export class B {
        private [" "]!: 'rustdoc_test_crate::B';

        constructor();
    }
}
