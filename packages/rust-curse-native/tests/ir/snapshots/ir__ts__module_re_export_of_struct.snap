---
source: tests/ir/ts.rs
description: "pub mod inner {\n    pub struct Inner {\n        pub x: i32,\n    }\n}\npub use inner::Inner;\n"
expression: ir.print_ts()
---
declare module "$rust-curse" {
    export type Copy<T> = {
        [K in keyof T as T[K] extends
            | string | number | boolean | bigint
            | Record<string, unknown> | unknown[]
            ? K : never]: Copy<T[K]>;
    };
}

declare module "$rust/rustdoc_test_crate" {
    export { Inner } from "$rust/rustdoc_test_crate/inner";
}

declare module "$rust/rustdoc_test_crate/inner" {
    export class Inner {
        private [" "]: 'rustdoc_test_crate::inner::Inner';

        x: number;

        constructor(x: number);
    }
}
