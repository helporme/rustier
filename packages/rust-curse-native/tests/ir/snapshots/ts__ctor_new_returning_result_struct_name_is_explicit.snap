---
source: tests/ir/ts.rs
description: "/// `new() -> Result<Token, _>` with a named struct in `Ok` is recognised as an\n/// explicit constructor. The `raw` param name differs from the field `value` so\n/// the snapshot proves the ctor is picked up rather than synthesised.\npub struct Token {\n    value: String,\n}\nimpl Token {\n    pub fn new(raw: String) -> Result<Token, String> {\n        Ok(Token { value: raw })\n    }\n}\n"
expression: ir.print_ts()
---
declare module "$rust-curse" {
    export type Copy<T> = {
        [K in keyof T as T[K] extends
            | string | number | boolean | bigint
            | Record<string, unknown> | unknown[]
            ? K : never]: Copy<T[K]>;
    };
}

declare module "$rust/rustdoc_test_crate" {
    /**
     * `new() -> Result<Token, _>` with a named struct in `Ok` is recognised as an
     * explicit constructor. The `raw` param name differs from the field `value` so
     * the snapshot proves the ctor is picked up rather than synthesised.
     */
    export class Token {
        private [" "]!: 'rustdoc_test_crate::Token';

        constructor(raw: string);
    }
}
