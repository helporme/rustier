/// By-value nominal types are wrapped in `Copy<>`, borrows are not.
pub struct Point {
    /// X coordinate.
    pub x: f64,
    /// Y coordinate.
    pub y: f64,
}
pub fn translate(origin: &Point, target: &mut Point, offset: Point) {}
