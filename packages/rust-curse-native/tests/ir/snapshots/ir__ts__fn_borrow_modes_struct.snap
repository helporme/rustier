import type { Copy } from "$rust-curse";

/** By-value nominal types are wrapped in `Copy<>`, borrows are not. */
export class Point {
    private [" "]: 'rustdoc_test_crate::Point';

    /** X coordinate. */
    x: number;

    /** Y coordinate. */
    y: number;

    constructor(x: number, y: number);
}

export function translate(origin: Point, target: Point, offset: Copy<Point>): void;
