---
source: tests/ir/ts.rs
description: "/// `new() -> Result<Self, _>` in a trait impl is recognised as an explicit\n/// constructor. The `seed` param name differs from the field `x` so the snapshot\n/// proves the trait-impl ctor is picked up rather than synthesised.\npub trait TryFactory {\n    fn new(seed: u32) -> Result<Self, String>\n    where\n        Self: Sized;\n}\npub struct Foo {\n    x: i32,\n}\nimpl TryFactory for Foo {\n    fn new(seed: u32) -> Result<Self, String> {\n        Ok(Foo { x: seed as i32 })\n    }\n}\n"
expression: ir.print_ts()
---
declare module "$rust-curse" {
    export type Copy<T> = {
        [K in keyof T as T[K] extends
            | string | number | boolean | bigint
            | Record<string, unknown> | unknown[]
            ? K : never]: Copy<T[K]>;
    };
}

declare module "$rust/rustdoc_test_crate" {
    export class Foo {
        private [" "]!: 'rustdoc_test_crate::Foo';

        constructor(seed: number);
    }
}
