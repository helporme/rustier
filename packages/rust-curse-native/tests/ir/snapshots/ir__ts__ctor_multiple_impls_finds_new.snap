```rs
/// The `seed` param name differs from the field `count` so the snapshot proves
/// the ctor from the second impl block is picked up.
pub struct Counter {
    count: u32,
}
impl Counter {
    pub fn increment(&mut self) {
        self.count += 1;
    }
}
impl Counter {
    pub fn new(seed: u32) -> Self {
        Counter { count: seed }
    }
}
```

