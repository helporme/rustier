source: tests/ir/ts.rs
description: "/// `new(&self)` is not treated as an explicit ctor.\npub struct Builder {\n    x: i32,\n}\nimpl Builder {\n    pub fn new(&self) -> Self {\n        Self { x: self.x }\n    }\n}\n"
expression: ir.print_ts()
---
declare module "$rust-curse" {
    export type Copy<T> = {
        [K in keyof T as T[K] extends
            | string | number | boolean | bigint
            | Record<string, unknown> | unknown[]
            ? K : never]: Copy<T[K]>;
    };
}

declare module "$rust/rustdoc_test_crate" {
    /** `new(&self)` is not treated as an explicit ctor. */
    export class Builder {
        private [" "]!: 'rustdoc_test_crate::Builder';

        constructor();
    }
