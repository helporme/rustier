`.rust-curse/build.rs`
```rs
fn main() {
    {
        println!("cargo:rerun-if-env-changed=RUST_CURSE_RUSTDOC");
        if std::env::var("RUST_CURSE_RUSTDOC").is_ok() {
            println!("cargo:rustc-cfg=rust_curse_rustdoc");
        }
    }
}
```

`.rust-curse/lib.rs`
```rs
#[cfg(rust_curse_rustdoc)]
include!("rustdoc.rs");
```

`.rust-curse/rustdoc/MyMod.rs`
```rs
#[path = "<root>/src/MyMod/something.rs"]
pub mod something;

```

`.rust-curse/rustdoc.rs`
```rs
#[path = "<root>/.rust-curse/rustdoc/MyMod.rs"]
#[allow(non_snake_case)]
pub mod MyMod;

```
