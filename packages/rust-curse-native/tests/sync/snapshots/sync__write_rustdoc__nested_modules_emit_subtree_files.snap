`.rust-curse/build.rs`
```rs
fn main() {
    {
        println!("cargo:rerun-if-env-changed=RUST_CURSE_RUSTDOC");
        println!("cargo:rustc-check-cfg=cfg(rust_curse_rustdoc)");
        if std::env::var("RUST_CURSE_RUSTDOC").is_ok() {
            println!("cargo:rustc-cfg=rust_curse_rustdoc");
        }
    }
}
```

