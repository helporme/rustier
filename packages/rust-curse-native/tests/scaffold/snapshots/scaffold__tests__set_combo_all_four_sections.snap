# patched by rust-curse with love <3
[package]
name = "test_crate"
version = "0.0.0"
edition = "2021"
build = ".rust-curse/build.rs" # do not change

[lib]
path = ".rust-curse/lib.rs" # do not change

[features]
node = ["dep:napi", "dep:napi-derive"] # do not change
wasm = ["dep:wasm-bindgen", "dep:serde", "dep:serde-wasm-bindgen"] # do not change

[dependencies]
napi = { version = "3", optional = true } # do not change
napi-derive = { version = "3", optional = true } # do not change
wasm-bindgen = { version = "0.2", optional = true } # do not change
serde = { version = "1", features = ["derive"], optional = true } # do not change
serde-wasm-bindgen = { version = "0.6", optional = true } # do not change

[build-dependencies]
