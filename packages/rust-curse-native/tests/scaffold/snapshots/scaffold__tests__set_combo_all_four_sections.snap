#[cfg(feature = "node")]
#[path = "build-napi.rs"]
mod build_napi;

fn main() {
    if std::env::var("RUST_CURSE_RUSTDOC").is_ok() {
        println!("cargo:rustc-cfg=rust_curse_rustdoc");
    }
    #[cfg(feature = "node")]
    build_napi::setup();
}
