	#[napi(getter, js_name = "supported")]
	pub fn __getter__supported(&self) -> napi::Result<i32> {
		let src = self.src.borrow();
		let result = src.supported.clone();
			Ok(result)
	}
	
	#[napi(setter, js_name = "supported")]
	pub fn __setter__supported(&self, __p__supported: Unknown<'_>) -> napi::Result<()> {
		let mut src = self.src.borrow_mut();
		let __p__supported = __cast_i32(__p__supported).map_err(|err| napi::Error::from_reason(format!("Invalid argument `supported`: expected Rust `i32` from a JavaScript number: {}", err)))?;
		src.supported = __p__supported;
