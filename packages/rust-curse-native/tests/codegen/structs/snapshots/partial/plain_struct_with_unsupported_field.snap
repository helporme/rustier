## Wasm Bindings

```rs
#![allow(non_camel_case_types, non_snake_case)]
use wasm_bindgen::prelude::*;

#[allow(non_snake_case, dead_code)]
mod __curse {
    use std::cell::RefCell;
    use std::rc::Rc;

    pub trait Projection<T> {
        fn with(&self, f: &mut dyn FnMut(&T));
        fn with_mut(&self, f: &mut dyn FnMut(&mut T));
    }

    impl<T> Projection<T> for RefCell<T> {
        fn with(&self, f: &mut dyn FnMut(&T)) {
            f(&*self.borrow());
        }
        fn with_mut(&self, f: &mut dyn FnMut(&mut T)) {
            f(&mut *self.borrow_mut());
        }
    }

    pub struct Projector<Parent, T> {
        pub parent: Rc<RefCell<Rc<dyn Projection<Parent>>>>,
        pub project: fn(&Parent) -> &T,
        pub project_mut: fn(&mut Parent) -> &mut T,
    }

    impl<Parent: 'static, T: 'static> Projection<T> for Projector<Parent, T> {
        fn with(&self, f: &mut dyn FnMut(&T)) {
            let parent = self.parent.borrow().clone();
            parent.with(&mut |p| f((self.project)(p)))
        }
        fn with_mut(&self, f: &mut dyn FnMut(&mut T)) {
            let parent = self.parent.borrow().clone();
            parent.with_mut(&mut |p| f((self.project_mut)(p)))
        }
    }
}

fn __cast_f64(value: JsValue) -> Result<f64, String> {
	value.as_f64().ok_or_else(|| "cannot cast value to f64".to_string())
}
fn __cast_i32(value: JsValue) -> Result<i32, String> {
	let value = __cast_f64(value).map_err(|_| "cannot cast value to i32".to_string())?;
	if value.trunc() != value || value < i32::MIN as f64 || value > i32::MAX as f64
	{
		return Err(format!("cannot cast {} to i32", value));
	}
	Ok(value as i32)
}

#[wasm_bindgen(js_name = __cursed_struct__rustdoc_0test_0crate_PlainStruct)]
pub struct __cursed_struct__rustdoc_0test_0crate_PlainStruct {
	src: std::cell::RefCell<rustdoc_test_crate::PlainStruct>
}

#[wasm_bindgen]
impl __cursed_struct__rustdoc_0test_0crate_PlainStruct {
	#[wasm_bindgen(getter, js_name = supported)]
	pub fn __getter__supported(&self) -> Result<i32, JsValue> {
		let src = self.src.borrow();
		let result = src.supported.clone();
			Ok(result)
	}
	
	#[wasm_bindgen(setter, js_name = supported)]
	pub fn __setter__supported(&self, __p__supported: JsValue) -> Result<(), JsValue> {
		let mut src = self.src.borrow_mut();
		let __p__supported = __cast_i32(__p__supported).map_err(|err| JsValue::from_str(&format!("Invalid argument `supported`: expected Rust `i32` from a JavaScript number: {}", err)))?;
		src.supported = __p__supported;
		Ok(())
	}
	
}

