fn __cast_f64(
	value: JsValue
)-> Result<f64, String> {
	value.as_f64().ok_or_else(|| "cannot cast value to f64".to_string())
}

fn __cast_i32(
	value: JsValue
)-> Result<i32, String> {
	let type_name = "i32";
	let value = __cast_f64(
		value
	).map_err(
		|_| format!(
			"cannot cast value to {type_name}"
		)
	)?;
	if value.trunc() != value || value < i32::MIN as f64 || value > i32::MAX as f64 {
		return Err(
			format!(
				"cannot cast {value} to {type_name}"
			)
		);
	}
	Ok(
		value as i32
	)
}

fn __cast_String(
	value: JsValue
)-> Result<String, String> {
	value.as_string().ok_or_else(|| "cannot cast value to String".to_string())
