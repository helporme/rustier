#![allow(non_camel_case_types, non_snake_case)]
use napi::bindgen_prelude::{Unknown, ValueType};
use napi_derive::napi;

#[allow(non_snake_case, dead_code)]
mod __curse {
    use std::cell::RefCell;
    use std::rc::Rc;

    pub trait Accessor<T> {
        fn access(&self, f: &mut dyn FnMut(&T));
        fn access_mut(&self, f: &mut dyn FnMut(&mut T));
    }

    impl<T> Accessor<T> for RefCell<T> {
        fn access(&self, f: &mut dyn FnMut(&T)) {
            f(&*self.borrow());
        }
        fn access_mut(&self, f: &mut dyn FnMut(&mut T)) {
            f(&mut *self.borrow_mut());
        }
    }

    pub enum Backing<T> {
        Owned(T),
        Projected(Rc<dyn Accessor<T>>),
    }

    pub struct Slot<T>(RefCell<Backing<T>>);

    impl<T: 'static> Slot<T> {
        pub fn owned(value: T) -> Self {
            Slot(RefCell::new(Backing::Owned(value)))
        }
        pub fn projected(projection: Rc<dyn Accessor<T>>) -> Self {
            Slot(RefCell::new(Backing::Projected(projection)))
        }
        pub fn replace_with_owned(&self, value: T) {
            *self.0.borrow_mut() = Backing::Owned(value);
        }
    }

    impl<T> Accessor<T> for Slot<T> {
        fn access(&self, f: &mut dyn FnMut(&T)) {
            let projection = {
                let target = self.0.borrow();

                match &*target {
                    Backing::Owned(value) => {
                        f(value);
                        return;
                    }
                    Backing::Projected(access) => Rc::clone(access),
                }
            };
            projection.access(f);
        }

        fn access_mut(&self, f: &mut dyn FnMut(&mut T)) {
            let projection = {
                let mut target = self.0.borrow_mut();

                match &mut *target {
                    Backing::Owned(value) => {
                        f(value);
                        return;
                    }
                    Backing::Projected(access) => Rc::clone(access),
                }
            };
            projection.access_mut(f);
        }
    }

    pub struct Projection<Parent, T> {
        pub parent: Rc<dyn Accessor<Parent>>,
        pub project: fn(&Parent) -> &T,
        pub project_mut: fn(&mut Parent) -> &mut T,
    }

    impl<Parent: 'static, T: 'static> Accessor<T> for Projection<Parent, T> {
        fn access(&self, f: &mut dyn FnMut(&T)) {
            self.parent.access(&mut |p| f((self.project)(p)))
        }
        fn access_mut(&self, f: &mut dyn FnMut(&mut T)) {
            self.parent.access_mut(&mut |p| f((self.project_mut)(p)))
        }
    }
}
use __curse::Accessor as _;

fn __cast_bool(value: Unknown<'_>) -> Result<bool, String> {
	if value.get_type().map_err(|err| err.reason)? == ValueType::Boolean
	{
		unsafe { value.cast::<bool>() }.map_err(|_| "cannot cast value to bool".to_string())
	}
	else
	{
		Err("cannot cast value to bool".to_string())
	}
}
fn __cast_f64(value: Unknown<'_>) -> Result<f64, String> {
	if value.get_type().map_err(|err| err.reason)? == ValueType::Number
	{
		unsafe { value.cast::<f64>() }.map_err(|_| "cannot cast value to f64".to_string())
	}
	else
	{
		Err("cannot cast value to f64".to_string())
	}
}
fn __cast_i8(value: Unknown<'_>) -> Result<i8, String> {
	let value = __cast_f64(value).map_err(|_| "cannot cast value to i8".to_string())?;
	if value.trunc() != value || value < i8::MIN as f64 || value > i8::MAX as f64
	{
		return Err(format!("cannot cast {} to i8", value));
	}
	Ok(value as i8)
}
fn __cast_i16(value: Unknown<'_>) -> Result<i16, String> {
	let value = __cast_f64(value).map_err(|_| "cannot cast value to i16".to_string())?;
