	use super::*;
	use std::cell::RefCell;
	use std::rc::Rc;

	pub type AccessResult<T> = Result<T, JsValue>;

	#[doc = r" Borrows a tethered value or returns an API-specific aliasing error.@"]pub fn try_borrow<T>(
		value: &RefCell<T>
	)-> AccessResult<std::cell::Ref<'_, T>> {
		value.try_borrow().map_err(
			|_| JsValue::from_str(
				&"cannot access a tethered value while it is mutably borrowed".to_string()
			)
		)
	}

	#[doc =
	r" Mutably borrows a tethered value or returns an API-specific aliasing error.@"]pub fn try_borrow_mut<T>(
		value: &RefCell<T>
	)-> AccessResult<std::cell::RefMut<'_, T>> {
		value.try_borrow_mut().map_err(
			|_| JsValue::from_str(
				&"cannot mutably access a tethered value while it is borrowed".to_string()
			)
		)
	}

	pub trait Accessor<T> {
		fn access(
			&self, f: &mut dyn FnMut(
				&T
			)-> AccessResult<()>
		)-> AccessResult<()>;
		fn access_mut(
			&self, f: &mut dyn FnMut(
				&mut T
			)-> AccessResult<()>
		)-> AccessResult<()>;
	}

	impl<T> Accessor<T> for RefCell<T> {
		fn access(
			&self, f: &mut dyn FnMut(
				&T
			)-> AccessResult<()>
		)-> AccessResult<()> {
			let value = try_borrow(
				self
			)?;
			f(
				&*value
			)
		}
		fn access_mut(
			&self, f: &mut dyn FnMut(
				&mut T
			)-> AccessResult<()>
		)-> AccessResult<()> {
			let mut value = try_borrow_mut(
				self
			)?;
			f(
				&mut *value
			)
		}
	}

	pub enum Source<T> {
		Owned(
			T
		),
		Projected(
			Rc<dyn Accessor<T>>
		),
	}

	pub struct SourceSlot<T>(
		RefCell<Source<T>>
	);

	impl<T: 'static> SourceSlot<T> {
		pub fn owned(
			value: T
		)-> Self {
			SourceSlot(
				RefCell::new(
					Source::Owned(
						value
					)
				)
			)
		}
		pub fn projected(
			accessor: Rc<dyn Accessor<T>>
		)-> Self {
			SourceSlot(
				RefCell::new(
					Source::Projected(
						accessor
					)
				)
			)
		}
		pub fn replace_with_owned(
			&self, value: T
		)-> AccessResult<()> {
			*try_borrow_mut(
				&self.0
			)? = Source::Owned(
				value
			);
			Ok(
				()
			)
		}
	}

	impl<T> Accessor<T> for SourceSlot<T> {
		fn access(
			&self, f: &mut dyn FnMut(
				&T
			)-> AccessResult<()>
		)-> AccessResult<()> {
			let accessor = {
				let source = try_borrow(
					&self.0
				)?;

				match &*source {
					Source::Owned(
						value
					)=> return f(
						value
					),
					Source::Projected(
						accessor
					)=> Rc::clone(
						accessor
					),
				}
			};
			accessor.access(
				f
			)
		}

		fn access_mut(
			&self, f: &mut dyn FnMut(
				&mut T
			)-> AccessResult<()>
		)-> AccessResult<()> {
			let accessor = {
				let mut source = try_borrow_mut(
					&self.0
				)?;

				match &mut *source {
					Source::Owned(
						value
					)=> return f(
						value
					),
					Source::Projected(
						accessor
					)=> Rc::clone(
						accessor
					),
				}
			};
			accessor.access_mut(
				f
			)
		}
	}

	pub struct FieldAccess<Parent, T> {
		pub parent: Rc<dyn Accessor<Parent>>,
		pub get: for<'a> fn(
			&'a Parent
		)-> AccessResult<&'a T>,
		pub get_mut: for<'a> fn(
			&'a mut Parent
		)-> AccessResult<&'a mut T>,
	}

	impl<Parent: 'static, T: 'static> Accessor<T> for FieldAccess<Parent, T> {
		fn access(
			&self, f: &mut dyn FnMut(
				&T
			)-> AccessResult<()>
		)-> AccessResult<()> {
			self.parent.access(
				&mut |parent| f(
					(
						self.get
					)(
						parent
					)?
				)
			)
		}
		fn access_mut(
			&self, f: &mut dyn FnMut(
				&mut T
			)-> AccessResult<()>
		)-> AccessResult<()> {
			self.parent.access_mut(
				&mut |parent| f(
					(
						self.get_mut
					)(
						parent
					)?
				)
			)
		}
	}
