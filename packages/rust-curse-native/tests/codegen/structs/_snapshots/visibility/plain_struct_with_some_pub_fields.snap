use __tethering::Accessor as _;

fn __cast_bool(
	value: Unknown<'_>
)-> Result<bool, String> {
	if value.get_type().map_err(
		|err| err.reason
	)? == ValueType::Boolean {
		unsafe {
			value.cast::<bool>()
		}.map_err(
			|_| "cannot cast value to bool".to_string()
		)
	}
	else {
		Err(
			"cannot cast value to bool".to_string()
		)
	}
}

