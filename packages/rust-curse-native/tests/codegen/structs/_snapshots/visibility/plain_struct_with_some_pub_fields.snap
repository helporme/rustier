			).map_err(
				|err| napi::Error::from_reason(
					format!(
						"Expected Rust `bool` from a JavaScript boolean: {}", err
					)
				)
			)?;
			result.write(
				value
			);
			unsafe {
				result.assume_init()
			}
		};
		self.src.set_c(
			value
		)?;Ok(
			()
		)
	}
}
```
