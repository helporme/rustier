#![allow(
	non_camel_case_types, non_snake_case
)]
use napi::bindgen_prelude::{Unknown, ValueType};
use napi_derive::napi;

#[allow(non_snake_case, dead_code)]
mod __tethering {
    use std::cell::RefCell;
    use std::rc::Rc;

    pub trait Accessor<T> {
        fn access(&self, f: &mut dyn FnMut(&T));
        fn access_mut(&self, f: &mut dyn FnMut(&mut T));
    }

    impl<T> Accessor<T> for RefCell<T> {
        fn access(&self, f: &mut dyn FnMut(&T)) {
            f(&*self.borrow());
        }
        fn access_mut(&self, f: &mut dyn FnMut(&mut T)) {
            f(&mut *self.borrow_mut());
        }
    }

    pub enum Source<T> {
        Owned(T),
        Projected(Rc<dyn Accessor<T>>),
    }

    pub struct SourceSlot<T>(RefCell<Source<T>>);

    impl<T: 'static> SourceSlot<T> {
        pub fn owned(value: T) -> Self {
            SourceSlot(RefCell::new(Source::Owned(value)))
        }
        pub fn projected(accessor: Rc<dyn Accessor<T>>) -> Self {
            SourceSlot(RefCell::new(Source::Projected(accessor)))
        }
        pub fn replace_with_owned(&self, value: T) {
            *self.0.borrow_mut() = Source::Owned(value);
        }
    }

    impl<T> Accessor<T> for SourceSlot<T> {
        fn access(&self, f: &mut dyn FnMut(&T)) {
            let accessor = {
                let source = self.0.borrow();

                match &*source {
                    Source::Owned(value) => {
                        f(value);
                        return;
                    }
                    Source::Projected(accessor) => Rc::clone(accessor),
                }
            };
            accessor.access(f);
        }

        fn access_mut(&self, f: &mut dyn FnMut(&mut T)) {
            let accessor = {
                let mut source = self.0.borrow_mut();

                match &mut *source {
                    Source::Owned(value) => {
                        f(value);
                        return;
                    }
                    Source::Projected(accessor) => Rc::clone(accessor),
                }
            };
            accessor.access_mut(f);
        }
    }

    pub struct FieldAccess<Parent, T> {
        pub parent: Rc<dyn Accessor<Parent>>,
        pub get: fn(&Parent) -> &T,
        pub get_mut: fn(&mut Parent) -> &mut T,
    }

    impl<Parent: 'static, T: 'static> Accessor<T> for FieldAccess<Parent, T> {
        fn access(&self, f: &mut dyn FnMut(&T)) {
            self.parent.access(&mut |parent| f((self.get)(parent)))
        }
        fn access_mut(&self, f: &mut dyn FnMut(&mut T)) {
            self.parent
                .access_mut(&mut |parent| f((self.get_mut)(parent)))
        }
    }
}
use __tethering::Accessor as _;

fn __cast_f64(
	value: Unknown<'_>
)-> Result<f64, String> {
	if value.get_type().map_err(
		|err| err.reason
	)? == ValueType::Number {
		unsafe {
			value.cast::<f64>()
		}.map_err(
			|_| "cannot cast value to f64".to_string()
		)
	}
	else {
		Err(
			"cannot cast value to f64".to_string()
		)
	}
}

fn __cast_u32(
	value: Unknown<'_>
)-> Result<u32, String> {
	let type_name = "u32";
	let value = __cast_f64(
		value
	).map_err(
		|_| format!(
			"cannot cast value to {type_name}"
		)
	)?;
	if value.trunc() != value || value < 0 as f64 || value > u32::MAX as f64 {
		return Err(
			format!(
				"cannot cast {value} to {type_name}"
			)
		);
	}
	Ok(
		value as u32
	)
}

fn __cast_char(
	value: Unknown<'_>
)-> Result<char, String> {
	let value = __cast_u32(
		value
	).map_err(
		|_| "cannot cast value to char".to_string()
	)?; char::from_u32(
		value
	).ok_or_else(
		|| format!(
			"cannot cast {value} to char"
		)
	)
}

