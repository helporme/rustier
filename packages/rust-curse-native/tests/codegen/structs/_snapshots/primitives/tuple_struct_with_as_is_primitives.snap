    impl<T> Accessor<T> for SourceSlot<T> {
        fn access(&self, f: &mut dyn FnMut(&T)) {
            let accessor = {
                let source = self.0.borrow();

                match &*source {
                    Source::Owned(value) => {
                        f(value);
