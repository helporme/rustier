    pub trait Accessor<T> {
        fn access(&self, f: &mut dyn FnMut(&T));
        fn access_mut(&self, f: &mut dyn FnMut(&mut T));
    }

    impl<T> Accessor<T> for RefCell<T> {
        fn access(&self, f: &mut dyn FnMut(&T)) {
            f(&*self.borrow());
        }
        fn access_mut(&self, f: &mut dyn FnMut(&mut T)) {
            f(&mut *self.borrow_mut());
        }
    }

    pub enum Source<T> {
        Owned(T),
        Projected(Rc<dyn Accessor<T>>),
    }

