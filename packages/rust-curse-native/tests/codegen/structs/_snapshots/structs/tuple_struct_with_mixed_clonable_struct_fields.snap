		value: &RefCell<T>
	)-> AccessResult<std::cell::RefMut<'_, T>> {
		value.try_borrow_mut().map_err(
			|_| napi::Error::from_reason(
				"cannot mutably access a tethered value while it is borrowed".to_string()
			)
		)
