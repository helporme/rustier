	pub trait Accessor<T> {
		fn access(
			&self, f: &mut dyn FnMut(
				&T
			)-> AccessResult<()>
		)-> AccessResult<()>;
		fn access_mut(
			&self, f: &mut dyn FnMut(
				&mut T
			)-> AccessResult<()>
		)-> AccessResult<()>;
	}

	impl<T> Accessor<T> for RefCell<T> {
		fn access(
			&self, f: &mut dyn FnMut(
				&T
			)-> AccessResult<()>
		)-> AccessResult<()> {
			let value = try_borrow(
				self
			)?;
			f(
				&*value
			)
		}
		fn access_mut(
			&self, f: &mut dyn FnMut(
