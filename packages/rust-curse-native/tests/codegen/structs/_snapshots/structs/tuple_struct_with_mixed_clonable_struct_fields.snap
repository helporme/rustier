		value: &RefCell<T>
	)-> AccessResult<std::cell::Ref<'_, T>> {
		value.try_borrow().map_err(
			|_| napi::Error::from_reason(
				"cannot access a tethered value while it is mutably borrowed".to_string()
			)
		)
	}

