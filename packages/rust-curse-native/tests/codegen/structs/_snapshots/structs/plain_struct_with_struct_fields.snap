#[derive(Clone)]
pub struct PlainField {
    pub value: i32,
}
#[derive(Clone)]
pub struct TupleField(pub String);
#[derive(Clone)]
pub struct Parent {
    pub plain: PlainField,
    pub tuple: TupleField,
}
