#![allow(
	non_camel_case_types, non_snake_case
)]
use napi::bindgen_prelude::{Unknown, ValueType};
use napi_derive::napi;

fn __cast_String(
	value: Unknown<'_>
)-> Result<String, String> {
	if value.get_type().map_err(
		|err| err.reason
	)? == ValueType::String {
		unsafe {
			value.cast::<String>()
		}.map_err(
			|_| "cannot cast value to String".to_string()
		)
	}
	else {
		Err(
			"cannot cast value to String".to_string()
		)
	}
}

#[napi(js_name = "__fn__rustdoc_0test_0crate_foo")]
pub fn __fn__rustdoc_0test_0crate_foo(
	__p___: String
) -> napi::Result<()> {
	let value = __p___;
	let value = {
		let value = value;
		(
			if value.get_type().map_err(
				|err| napi::Error::from_reason(
					err.reason
				)
			)? == ValueType::String {
				unsafe {
					value.cast::<String>()
				}.map_err(
					|_| napi::Error::from_reason(
						"cannot cast value to String".to_string()
					)
				)
			}
			else {
				Err(
					napi::Error::from_reason(
						"cannot cast value to String".to_string()
					)
				)
			}
		)?
	};
	let __p___ = value;
	rustdoc_test_crate::foo(
		__p___
	);
	Ok(
		()
	)
}
