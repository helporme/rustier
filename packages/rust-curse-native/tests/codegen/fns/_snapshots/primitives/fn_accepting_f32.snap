#![allow(
	non_camel_case_types, non_snake_case
)]
use wasm_bindgen::prelude::*;

fn __cast_f64(
	value: JsValue
)-> Result<f64, String> {
	value.as_f64().ok_or_else(
		|| "cannot cast value to f64".to_string()
	)
}

fn __cast_f32(
	value: JsValue
)-> Result<f32, String> {
	let type_name = "f32";
	let value = __cast_f64(
		value
	).map_err(
		|_| format!(
			"cannot cast value to {type_name}"
		)
	)?;
	Ok(
		value as f32
	)
}

#[wasm_bindgen(js_name = "__fn__rustdoc_0test_0crate_foo")]
pub fn __fn__rustdoc_0test_0crate_foo(
	__p__value: f64
) -> Result<(), JsValue> {
	let value = __p__value;
	let value = {
		let value = value;
		(
			value.as_f64().ok_or_else(
				|| JsValue::from_str(
					&"cannot cast value to f64".to_string()
				)
			)
		)?
	};
	let value = {
		value as f32
	};
	let __p__value = value;
	rustdoc_test_crate::foo(
		__p__value
	);
	Ok(
		()
	)
}
