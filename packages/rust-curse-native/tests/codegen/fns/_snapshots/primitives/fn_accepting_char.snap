## Node Bindings

```rs
#![allow(
	non_camel_case_types, non_snake_case
)]
use napi::bindgen_prelude::{Unknown, ValueType};
use napi_derive::napi;

fn __cast_f64(
	value: Unknown<'_>
)-> Result<f64, String> {
	if value.get_type().map_err(
		|err| err.reason
	)? == ValueType::Number {
		unsafe {
			value.cast::<f64>()
		}.map_err(
			|_| "cannot cast value to f64".to_string()
		)
	}
	else {
		Err(
			"cannot cast value to f64".to_string()
		)
	}
}

fn __cast_u32(
	value: Unknown<'_>
)-> Result<u32, String> {
	let type_name = "u32";
	let value = __cast_f64(
		value
	).map_err(
		|_| format!(
			"cannot cast value to {type_name}"
		)
	)?;
	if value.trunc() != value || value < 0 as f64 || value > u32::MAX as f64 {
		return Err(
			format!(
				"cannot cast {value} to {type_name}"
			)
		);
	}
	Ok(
		value as u32
	)
}

fn __cast_char(
	value: Unknown<'_>
)-> Result<char, String> {
	let value = __cast_u32(
		value
	).map_err(
		|_| "cannot cast value to char".to_string()
	)?; char::from_u32(
		value
	).ok_or_else(
		|| format!(
			"cannot cast {value} to char"
		)
	)
}

#[napi(js_name = "__fn__rustdoc_0test_0crate_foo")]
pub fn __fn__rustdoc_0test_0crate_foo(
	__p__value: u32
) -> napi::Result<()> {
	let value = __p__value;
	let value = {
		let value = value;
		(
			if value.get_type().map_err(
				|err| napi::Error::from_reason(
					err.reason
				)
			)? == ValueType::Number {
				unsafe {
					value.cast::<f64>()
				}.map_err(
					|_| napi::Error::from_reason(
						"cannot cast value to f64".to_string()
					)
				)
			}
			else {
				Err(
					napi::Error::from_reason(
						"cannot cast value to f64".to_string()
					)
				)
			}
		)?
	};
	let value = {
		let type_name = "u32";
		let value = value;
		if value.trunc() != value || value < 0 as f64 || value > u32::MAX as f64 {
			return Err(
				napi::Error::from_reason(
					format!(
						"cannot cast {value} to {type_name}"
					)
				)
			);
		}
		value as u32
	};
	let value = {
		let value = value;
		char::from_u32(
			value
		).ok_or_else(
			|| napi::Error::from_reason(
				format!(
					"cannot cast {value} to char"
				)
			)
		)?
	};
	let __p__value = value;
	rustdoc_test_crate::foo(
		__p__value
	);
	Ok(
		()
	)
}
