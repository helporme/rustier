use napi::bindgen_prelude::{Unknown, ValueType};
use napi_derive::napi;

fn __cast_bool(
	value: Unknown<'_>
)-> Result<bool, String> {
	if value.get_type().map_err(
		|err| err.reason
	)? == ValueType::Boolean {
		unsafe {
			value.cast::<bool>()
		}.map_err(
			|_| "cannot cast value to bool".to_string()
		)
	}
	else {
		Err(
			"cannot cast value to bool".to_string()
		)
	}
}

fn __cast_f64(
	value: Unknown<'_>
)-> Result<f64, String> {
	if value.get_type().map_err(
		|err| err.reason
	)? == ValueType::Number {
		unsafe {
			value.cast::<f64>()
		}.map_err(
			|_| "cannot cast value to f64".to_string()
		)
	}
	else {
		Err(
			"cannot cast value to f64".to_string()
		)
	}
}

fn __cast_i8(
	value: Unknown<'_>
)-> Result<i8, String> {
	let type_name = "i8";
	let value = __cast_f64(
		value
	).map_err(
		|_| format!(
			"cannot cast value to {type_name}"
		)
	)?;
	if value.trunc() != value || value < i8::MIN as f64 || value > i8::MAX as f64 {
		return Err(
