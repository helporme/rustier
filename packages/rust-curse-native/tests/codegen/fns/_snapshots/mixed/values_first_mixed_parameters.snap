use napi::bindgen_prelude::{Unknown, ValueType};
use napi_derive::napi;

#[allow(
	non_snake_case, dead_code
)]
mod __tethering {
	use super::*;
	use std::cell::RefCell;
	use std::rc::Rc;

	pub type AccessResult<T> = napi::Result<T>;

	#[doc = r" Borrows a tethered value or returns an API-specific aliasing error.@"]pub fn try_borrow<T>(
		value: &RefCell<T>
	)-> AccessResult<std::cell::Ref<'_, T>> {
		value.try_borrow().map_err(
			|_| napi::Error::from_reason(
				"cannot access a tethered value while it is mutably borrowed".to_string()
			)
		)
	}

	#[doc =
	r" Mutably borrows a tethered value or returns an API-specific aliasing error.@"]pub fn try_borrow_mut<T>(
		value: &RefCell<T>
	)-> AccessResult<std::cell::RefMut<'_, T>> {
		value.try_borrow_mut().map_err(
			|_| napi::Error::from_reason(
				"cannot mutably access a tethered value while it is borrowed".to_string()
			)
		)
	}

	pub trait Accessor<T> {
		fn access(
			&self, f: &mut dyn FnMut(
				&T
			)-> AccessResult<()>
		)-> AccessResult<()>;
		fn access_mut(
			&self, f: &mut dyn FnMut(
				&mut T
			)-> AccessResult<()>
		)-> AccessResult<()>;
	}

	impl<T> Accessor<T> for RefCell<T> {
		fn access(
			&self, f: &mut dyn FnMut(
				&T
			)-> AccessResult<()>
		)-> AccessResult<()> {
			let value = try_borrow(
				self
			)?;
			f(
				&*value
			)
		}
		fn access_mut(
			&self, f: &mut dyn FnMut(
				&mut T
			)-> AccessResult<()>
		)-> AccessResult<()> {
			let mut value = try_borrow_mut(
				self
			)?;
			f(
				&mut *value
			)
		}
	}

	pub enum Source<T> {
		Owned(
			T
		),
		Projected(
			Rc<dyn Accessor<T>>
		),
	}

	pub struct SourceSlot<T>(
		RefCell<Source<T>>
	);

	impl<T: 'static> SourceSlot<T> {
		pub fn owned(
			value: T
		)-> Self {
			SourceSlot(
				RefCell::new(
					Source::Owned(
						value
					)
				)
			)
		}
		pub fn projected(
			accessor: Rc<dyn Accessor<T>>
		)-> Self {
			SourceSlot(
				RefCell::new(
					Source::Projected(
						accessor
					)
				)
			)
		}
		pub fn replace_with_owned(
			&self, value: T
		)-> AccessResult<()> {
			*try_borrow_mut(
				&self.0
			)? = Source::Owned(
				value
			);
			Ok(
				()
			)
		}
	}

	impl<T> Accessor<T> for SourceSlot<T> {
		fn access(
			&self, f: &mut dyn FnMut(
				&T
			)-> AccessResult<()>
		)-> AccessResult<()> {
			let accessor = {
				let source = try_borrow(
					&self.0
				)?;

				match &*source {
					Source::Owned(
						value
					)=> return f(
						value
					),
					Source::Projected(
						accessor
					)=> Rc::clone(
						accessor
					),
				}
			};
			accessor.access(
				f
			)
		}

		fn access_mut(
			&self, f: &mut dyn FnMut(
				&mut T
			)-> AccessResult<()>
		)-> AccessResult<()> {
			let accessor = {
				let mut source = try_borrow_mut(
					&self.0
				)?;

				match &mut *source {
					Source::Owned(
						value
					)=> return f(
						value
					),
					Source::Projected(
						accessor
					)=> Rc::clone(
						accessor
					),
				}
			};
			accessor.access_mut(
				f
			)
		}
	}

	pub struct FieldAccess<Parent, T> {
		pub parent: Rc<dyn Accessor<Parent>>,
		pub get: for<'a> fn(
			&'a Parent
		)-> AccessResult<&'a T>,
		pub get_mut: for<'a> fn(
			&'a mut Parent
		)-> AccessResult<&'a mut T>,
	}

	impl<Parent: 'static, T: 'static> Accessor<T> for FieldAccess<Parent, T> {
		fn access(
			&self, f: &mut dyn FnMut(
				&T
			)-> AccessResult<()>
		)-> AccessResult<()> {
			self.parent.access(
				&mut |parent| f(
					(
						self.get
					)(
						parent
					)?
				)
			)
		}
		fn access_mut(
			&self, f: &mut dyn FnMut(
				&mut T
			)-> AccessResult<()>
		)-> AccessResult<()> {
			self.parent.access_mut(
				&mut |parent| f(
					(
						self.get_mut
					)(
						parent
					)?
				)
			)
		}
	}
}
use __tethering::Accessor as _;

fn __cast_String(
	value: Unknown<'_>
)-> Result<String, String> {
	if value.get_type().map_err(
		|err| err.reason
	)? == ValueType::String {
		unsafe {
			value.cast::<String>()
		}.map_err(
			|_| "cannot cast value to String".to_string()
		)
	}
	else {
		Err(
			"cannot cast value to String".to_string()
		)
	}
}

fn __cast_f64(
	value: Unknown<'_>
)-> Result<f64, String> {
	if value.get_type().map_err(
		|err| err.reason
	)? == ValueType::Number {
		unsafe {
			value.cast::<f64>()
		}.map_err(
			|_| "cannot cast value to f64".to_string()
		)
	}
	else {
		Err(
			"cannot cast value to f64".to_string()
		)
	}
}

fn __cast_i32(
	value: Unknown<'_>
)-> Result<i32, String> {
	let type_name = "i32";
	let value = __cast_f64(
		value
	).map_err(
		|_| format!(
			"cannot cast value to {type_name}"
		)
	)?;
	if value.trunc() != value || value < i32::MIN as f64 || value > i32::MAX as f64 {
		return Err(
			format!(
				"cannot cast {value} to {type_name}"
			)
		);
	}
	Ok(
		value as i32
	)
}

