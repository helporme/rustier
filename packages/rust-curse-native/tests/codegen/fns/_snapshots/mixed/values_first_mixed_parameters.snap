## Source

```rs
#[derive(Clone)]
pub struct PlainStruct {
    pub value: i32,
}
#[derive(Clone)]
pub struct TupleStruct(pub String);
pub fn foo(
    text: &str,
    borrowed_text: &String,
    mutable_text: &mut String,
    number: f64,
    moved: TupleStruct,
    mutable: &mut PlainStruct,
    borrowed: &PlainStruct,
) -> PlainStruct {
    let _ = (text, borrowed_text, mutable_text, number, moved, mutable, borrowed);
    todo!()
}
```

