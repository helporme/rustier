## Node Bindings

```rs
#![allow(non_camel_case_types, non_snake_case)]
use napi::bindgen_prelude::{Unknown, ValueType};
use napi_derive::napi;

fn __cast_String(value: Unknown<'_>) -> Result<String, String> {
	if value.get_type().map_err(|err| err.reason)? == ValueType::String
	{
		unsafe { value.cast::<String>() }.map_err(|_| "cannot cast value to String".to_string())
	}
	else
	{
		Err("cannot cast value to String".to_string())
	}
}

#[napi(js_name = "__cursed_fn__rustdoc_0test_0crate_foo")]
pub fn __cursed_fn__rustdoc_0test_0crate_foo(
	__p___: Unknown<'_>,
) -> napi::Result<()> {
	let mut __p___ = __cast_String(__p___).map_err(|err| napi::Error::from_reason(format!("Invalid argument `_` passed to `foo`: expected Rust `String` from a JavaScript string: {}", err)))?;
	rustdoc_test_crate::foo(
		&mut __p___,
	);
	Ok(())
}
```

## Wasm Bindings

```rs
#![allow(non_camel_case_types, non_snake_case)]
use wasm_bindgen::prelude::*;

fn __cast_String(value: JsValue) -> Result<String, String> {
	value.as_string().ok_or_else(|| "cannot cast value to String".to_string())
}

#[wasm_bindgen(js_name = __cursed_fn__rustdoc_0test_0crate_foo)]
pub fn __cursed_fn__rustdoc_0test_0crate_foo(
	__p___: JsValue,
) -> Result<(), JsValue> {
	let mut __p___ = __cast_String(__p___).map_err(|err| JsValue::from_str(&format!("Invalid argument `_` passed to `foo`: expected Rust `String` from a JavaScript string: {}", err)))?;
	rustdoc_test_crate::foo(
		&mut __p___,
	);
	Ok(())
}
```
