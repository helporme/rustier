    text: &str,
    borrowed_text: &String,
    mutable_text: &mut String,
    number: f64,
    moved: TupleStruct,
    mutable: &mut PlainStruct,
    borrowed: &PlainStruct,
) -> PlainStruct {
    let _ = (text, borrowed_text, mutable_text, number, moved, mutable, borrowed);
    todo!()
}
