## Source

```rs
#[derive(Clone)]
pub struct PlainStruct {
    pub value: i32,
}
#[derive(Clone)]
pub struct TupleStruct(pub String);
pub fn foo(
    number: u32,
    moved: PlainStruct,
    text: String,
    borrowed: &TupleStruct,
    borrowed_text: &String,
    flag: bool,
    mutable_text: &mut String,
    mutable: &mut PlainStruct,
) -> TupleStruct {
    let _ = (number, moved, text, borrowed, borrowed_text, flag, mutable_text, mutable);
    todo!()
}
```

