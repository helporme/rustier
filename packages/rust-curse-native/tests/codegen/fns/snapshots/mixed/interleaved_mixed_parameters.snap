fn __cast_f64(
	value: Unknown<'_>
)-> Result<f64, String> {
	if value.get_type().map_err(
		|err| err.reason
	)? == ValueType::Number {
		unsafe {
			value.cast::<f64>()
		}.map_err(
			|_| "cannot cast value to f64".to_string()
		)
	}
	else {
		Err(
			"cannot cast value to f64".to_string()
		)
	}
}

fn __cast_u32(
	value: Unknown<'_>
)-> Result<u32, String> {
	let type_name = "u32";
	let value = __cast_f64(
		value
	).map_err(
		|_| format!(
			"cannot cast value to {type_name}"
		)
	)?;
	if value.trunc() != value || value < 0 as f64 || value > u32::MAX as f64 {
		return Err(
			format!(
				"cannot cast {value} to {type_name}"
			)
		);
	}
	Ok(
		value as u32
	)
}

