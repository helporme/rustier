## Node Bindings

```rs
#![allow(non_camel_case_types, non_snake_case)]
use napi::bindgen_prelude::{Unknown, ValueType};
use napi_derive::napi;

#[napi(js_name = "__cursed_fn__rustdoc_0test_0crate_foo")]
pub fn __cursed_fn__rustdoc_0test_0crate_foo(
	mut __p__value: Unknown<'_>,
) -> napi::Result<()> {
	let mut __p__value = if __p__value.get_type()? == ValueType::Number {
		unsafe { __p__value.cast::<u32>() }.map_err(|_| {
			napi::Error::from_reason(
				"Invalid argument `value` passed to `foo`: expected Rust `char` from a JavaScript number.",
			)
		})?
	} else {
		return Err(napi::Error::from_reason(
			"Invalid argument `value` passed to `foo`: expected Rust `char` from a JavaScript number.",
		));
	};
	let __p__value = char::from_u32(__p__value).ok_or_else(|| {
		napi::Error::from_reason(format!("invalid char code point: {}", __p__value))
	})?;
	rustdoc_test_crate::foo(
		__p__value,
	);
	Ok(())
}
```

