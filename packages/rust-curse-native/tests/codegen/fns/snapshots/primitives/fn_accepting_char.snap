use wasm_bindgen::prelude::*;

#[wasm_bindgen(js_name = __cursed_fn__rustdoc_0test_0crate_foo)]
pub fn __cursed_fn__rustdoc_0test_0crate_foo(
	mut __p__value: JsValue,
) -> Result<(), JsValue> {
	let mut __p__value = __p__value.as_f64().ok_or_else(|| {
		JsValue::from_str(
			"Invalid argument `value` passed to `foo`: expected Rust `char` from a JavaScript number.",
		)
	})? as u32;
	let __p__value = char::from_u32(__p__value).ok_or_else(|| {
