#![allow(non_camel_case_types, non_snake_case)]
use wasm_bindgen::prelude::*;

fn __cast_f64(
	value: JsValue
)-> Result<f64, String> {
	value.as_f64().ok_or_else(|| "cannot cast value to f64".to_string())
}

fn __cast_u32(
	value: JsValue
)-> Result<u32, String> {
	let type_name = "u32";
	let value = __cast_f64(
		value
	).map_err(
		|_| format!(
			"cannot cast value to {type_name}"
		)
	)?;
	if value.trunc() != value || value < 0 as f64 || value > u32::MAX as f64 {
		return Err(
			format!(
				"cannot cast {value} to {type_name}"
			)
		);
	}
	Ok(
		value as u32
	)
}

fn __cast_char(
	value: JsValue
)-> Result<char, String> {
	let value = __cast_u32(
		value
	).map_err(
		|_| "cannot cast value to char".to_string()
	)?; char::from_u32(
		value
	).ok_or_else(
		|| format!(
			"cannot cast {value} to char"
		)
	)
}

#[wasm_bindgen(js_name = "__cursed_fn__rustdoc_0test_0crate_foo")]
pub fn __cursed_fn__rustdoc_0test_0crate_foo(
	__p__value: JsValue
) -> Result<(), JsValue> {
	{
		let mut __p__value = __cast_char(__p__value).map_err(|err| JsValue::from_str(&format!("Expected Rust `char` from a JavaScript number: {}", err)))?;
		
		rustdoc_test_crate::foo(
			__p__value
		)
	}
	Ok(
		()
	)
}
