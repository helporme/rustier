## Node Bindings

```rs
#![allow(non_camel_case_types, non_snake_case)]
use napi::bindgen_prelude::{Unknown, ValueType};
use napi_derive::napi;

fn __cast_f64(value: Unknown<'_>) -> Result<f64, String> {
	if value.get_type().map_err(|err| err.reason)? == ValueType::Number
	{
		unsafe { value.cast::<f64>() }.map_err(|_| "cannot cast value to f64".to_string())
	}
	else
	{
		Err("cannot cast value to f64".to_string())
	}
}
fn __cast_f32(value: Unknown<'_>) -> Result<f32, String> {
	let value = __cast_f64(value).map_err(|_| "cannot cast value to f32".to_string())?;
	Ok(value as f32)
}

#[napi(js_name = "__cursed_fn__rustdoc_0test_0crate_foo")]
pub fn __cursed_fn__rustdoc_0test_0crate_foo(
	__p__value: Unknown<'_>,
) -> napi::Result<()> {
	let __p__value = __cast_f32(__p__value).map_err(|err| napi::Error::from_reason(format!("Invalid argument `value` passed to `foo`: expected Rust `f32` from a JavaScript number: {}", err)))?;
	rustdoc_test_crate::foo(
		__p__value,
	);
	Ok(())
}
```

## Wasm Bindings

```rs
#![allow(non_camel_case_types, non_snake_case)]
use wasm_bindgen::prelude::*;

fn __cast_f64(value: JsValue) -> Result<f64, String> {
	value.as_f64().ok_or_else(|| "cannot cast value to f64".to_string())
}
fn __cast_f32(value: JsValue) -> Result<f32, String> {
	let value = __cast_f64(value).map_err(|_| "cannot cast value to f32".to_string())?;
	Ok(value as f32)
}

#[wasm_bindgen(js_name = __cursed_fn__rustdoc_0test_0crate_foo)]
pub fn __cursed_fn__rustdoc_0test_0crate_foo(
	__p__value: JsValue,
) -> Result<(), JsValue> {
	let __p__value = __cast_f32(__p__value).map_err(|err| JsValue::from_str(&format!("Invalid argument `value` passed to `foo`: expected Rust `f32` from a JavaScript number: {}", err)))?;
	rustdoc_test_crate::foo(
		__p__value,
	);
	Ok(())
}
```
