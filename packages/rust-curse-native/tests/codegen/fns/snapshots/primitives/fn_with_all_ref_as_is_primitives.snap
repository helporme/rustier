#![allow(non_camel_case_types, non_snake_case)]
use napi::bindgen_prelude::{Unknown, ValueType};
use napi_derive::napi;

fn __cast_bool(value: Unknown<'_>) -> Result<bool, String> {
	if value.get_type().map_err(|err| err.reason)? == ValueType::Boolean
	{
		unsafe { value.cast::<bool>() }.map_err(|_| "cannot cast value to bool".to_string())
	}
	else
	{
		Err("cannot cast value to bool".to_string())
	}
}
fn __cast_String(value: Unknown<'_>) -> Result<String, String> {
	if value.get_type().map_err(|err| err.reason)? == ValueType::String
	{
		unsafe { value.cast::<String>() }.map_err(|_| "cannot cast value to String".to_string())
	}
	else
	{
		Err("cannot cast value to String".to_string())
	}
}
fn __cast_f64(value: Unknown<'_>) -> Result<f64, String> {
	if value.get_type().map_err(|err| err.reason)? == ValueType::Number
	{
		unsafe { value.cast::<f64>() }.map_err(|_| "cannot cast value to f64".to_string())
	}
	else
	{
		Err("cannot cast value to f64".to_string())
	}
}
fn __cast_i8(value: Unknown<'_>) -> Result<i8, String> {
	let value = __cast_f64(value).map_err(|_| "cannot cast value to i8".to_string())?;
	if value.trunc() != value || value < i8::MIN as f64 || value > i8::MAX as f64
	{
		return Err(format!("cannot cast {} to i8", value));
	}
	Ok(value as i8)
}
fn __cast_i16(value: Unknown<'_>) -> Result<i16, String> {
	let value = __cast_f64(value).map_err(|_| "cannot cast value to i16".to_string())?;
	if value.trunc() != value || value < i16::MIN as f64 || value > i16::MAX as f64
	{
		return Err(format!("cannot cast {} to i16", value));
	}
	Ok(value as i16)
}
fn __cast_i32(value: Unknown<'_>) -> Result<i32, String> {
	let value = __cast_f64(value).map_err(|_| "cannot cast value to i32".to_string())?;
	if value.trunc() != value || value < i32::MIN as f64 || value > i32::MAX as f64
	{
		return Err(format!("cannot cast {} to i32", value));
	}
	Ok(value as i32)
}
fn __cast_u8(value: Unknown<'_>) -> Result<u8, String> {
	let value = __cast_f64(value).map_err(|_| "cannot cast value to u8".to_string())?;
	if value.trunc() != value || value < 0 as f64 || value > u8::MAX as f64
	{
		return Err(format!("cannot cast {} to u8", value));
	}
	Ok(value as u8)
}
fn __cast_u16(value: Unknown<'_>) -> Result<u16, String> {
	let value = __cast_f64(value).map_err(|_| "cannot cast value to u16".to_string())?;
	if value.trunc() != value || value < 0 as f64 || value > u16::MAX as f64
	{
		return Err(format!("cannot cast {} to u16", value));
	}
	Ok(value as u16)
}
fn __cast_u32(value: Unknown<'_>) -> Result<u32, String> {
	let value = __cast_f64(value).map_err(|_| "cannot cast value to u32".to_string())?;
	if value.trunc() != value || value < 0 as f64 || value > u32::MAX as f64
	{
		return Err(format!("cannot cast {} to u32", value));
	}
	Ok(value as u32)
}

#[napi(js_name = "__cursed_fn__rustdoc_0test_0crate_foo")]
