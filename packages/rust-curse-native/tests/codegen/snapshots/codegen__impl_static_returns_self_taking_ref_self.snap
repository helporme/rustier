# Source

```rs
#[derive(Clone)]
pub struct Point {
    pub x: i32,
    pub y: i32,
}
impl Point {
    pub fn make_relative_to(p: &Self) -> Self {
        Self { x: p.x + 1, y: p.y + 1 }
    }
}
```

