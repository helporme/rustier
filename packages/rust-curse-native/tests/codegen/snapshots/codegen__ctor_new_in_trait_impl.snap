# Source

```rs
pub trait Factory {
    fn new(seed: u32) -> Self;
}
pub struct Foo {
    x: i32,
}
impl Factory for Foo {
    fn new(seed: u32) -> Self {
        Foo { x: seed as i32 }
    }
}
```

