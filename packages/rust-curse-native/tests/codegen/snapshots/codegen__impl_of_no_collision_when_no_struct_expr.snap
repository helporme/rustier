# Source

```rs
#[derive(Clone)]
pub struct Mat2x2 {
    _00: i32,
    _01: i32,
    _10: i32,
    _11: i32,
}
impl Mat2x2 {
    pub fn of(diag: i32) -> Self {
        Self {
            _00: diag,
            _01: 0,
            _10: 0,
            _11: diag,
        }
    }
}
```

