        fn with(&self, f: &mut dyn FnMut(&T)) -> Result<(), StaleRef> {
            f(&*self.borrow());
            Ok(())
        }
        fn with_mut(&self, f: &mut dyn FnMut(&mut T)) -> Result<(), StaleRef> {
            f(&mut *self.borrow_mut());
            Ok(())
        }
