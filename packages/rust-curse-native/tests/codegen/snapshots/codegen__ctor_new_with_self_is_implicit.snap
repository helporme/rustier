        let mut __cursed_ret: Option<crate::Builder> = None;
        __cursed_proj_self
            .with(
                &mut |__cursed_self| {
                    __cursed_ret = Some(crate::Builder::new(__cursed_self));
                },
            );
        let __cursed_ret_val = __cursed_ret.unwrap();
        Ok(__cursed_rustdoc_test_crate__Builder {
            __cursed_root: Rc::new(
                RefCell::new(
                    Rc::new(RefCell::new(__cursed_ret_val))
                        as Rc<dyn __cursed::Projection<crate::Builder>>,
