# Source

```rs
#[derive(Clone)]
pub struct Point {
    pub x: f64,
    pub y: f64,
}
#[derive(Clone)]
pub struct Line {
    pub start: Point,
    pub end: Point,
}
#[derive(Clone)]
pub struct Triangle {
    pub a: Line,
    pub b: Point,
}
