}
#[wasm_bindgen]
impl __cursed_rustdoc_test_crate__Mixed {
    #[wasm_bindgen(constructor)]
    pub fn new(__cursed_arg_x: i32) -> Self {
        Self {
            __cursed_root: Rc::new(
                RefCell::new(
                    Rc::new(RefCell::new(crate::Mixed { x: __cursed_arg_x }))
                        as Rc<dyn __cursed_Projection<crate::Mixed>>,
                ),
            ),
        }
    }
    #[wasm_bindgen(getter, js_name = "x")]
    pub fn __cursed_get_x(&self) -> i32 {
        let __cursed_proj = self.__cursed_root.borrow().clone();
        let mut __cursed_out: Option<i32> = None;
        __cursed_proj.with(&mut |__cursed_p| __cursed_out = Some(__cursed_p.x));
        __cursed_out.unwrap()
    }
    #[wasm_bindgen(setter, js_name = "x")]
    pub fn __cursed_set_x(&self, __cursed_arg_x: i32) {
        let __cursed_proj = self.__cursed_root.borrow().clone();
        let mut __cursed_arg = Some(__cursed_arg_x);
        __cursed_proj
            .with_mut(&mut |__cursed_p| __cursed_p.x = __cursed_arg.take().unwrap());
    }
