use wasm_bindgen::prelude::*;
#[wasm_bindgen(js_name = "__cursed_rustdoc_test_crate__Foo")]
pub struct __cursed_rustdoc_test_crate__Foo {
    inner: crate::Foo,
}
#[wasm_bindgen]
impl __cursed_rustdoc_test_crate__Foo {
    #[wasm_bindgen(constructor)]
    pub fn new(from_alpha: u64) -> Self {
        Self {
            inner: crate::Foo::new(from_alpha),
        }
    }
}
impl From<crate::Foo> for __cursed_rustdoc_test_crate__Foo {
    fn from(v: crate::Foo) -> Self {
        Self { inner: v }
    }
}
impl From<__cursed_rustdoc_test_crate__Foo> for crate::Foo {
    fn from(v: __cursed_rustdoc_test_crate__Foo) -> Self {
        v.inner
    }
}
