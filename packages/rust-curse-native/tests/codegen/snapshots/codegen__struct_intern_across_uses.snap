# Source

```rs
#[derive(Clone)]
pub struct Point {
    pub x: i32,
    pub y: i32,
}
pub struct Wrapper {
    pub p: Point,
}
pub fn take(p: Point) {}
pub fn produce() -> Point {
    Point { x: 0, y: 0 }
}
