        parent.with(&mut |p| f((self.project)(p)));
    }
    fn with_mut(&self, f: &mut dyn FnMut(&mut T)) {
        let parent = self.parent.borrow().clone();
        parent.with_mut(&mut |p| f((self.project_mut)(p)));
    }
