fn __cursed_coerce___cursed_rustdoc_test_crate__Empty<'a>(
    val: napi::bindgen_prelude::Unknown<'a>,
) -> napi::Result<__cursed::Coerced<crate::Empty>> {
    let __cursed_env_raw = napi::JsValue::value(&val).env;
    let __cursed_raw = napi::JsValue::raw(&val);
    if let Ok(__cursed_inst) = unsafe {
        napi::bindgen_prelude::ClassInstance::<
            __cursed_rustdoc_test_crate__Empty,
