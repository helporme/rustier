// src/lib.rs.d.ts
/** A point in 2D space. */
export class Point {
    private [" "]: 'rustdoc_test_crate::Point';

    /** Horizontal position. */
    x: number;

    /** Vertical position. */
    y: number;

    private constructor();

    static of(init: Point.Init): Point;
}

/** A point in 2D space. */
export namespace Point {
    export type Init = {
        /** Horizontal position. */
        x: number;
        /** Vertical position. */
        y: number;
    };
}

/** A circle defined by its center and radius. */
export class Circle {
    private [" "]: 'rustdoc_test_crate::Circle';

    /** The center point. */
    center: Point;

    /** The radius in the same units as `center`. */
    radius: number;

    private constructor();

    static of(init: Circle.Init): Circle;
}

/** A circle defined by its center and radius. */
export namespace Circle {
    export type Init = {
        /** The center point. */
        center: Point | Point.Init;
        /** The radius in the same units as `center`. */
        radius: number;
    };
}
