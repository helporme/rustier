# Source

```rs
/// A point in 2D space.
#[derive(Clone)]
pub struct Point {
    /// Horizontal position.
    pub x: f64,
    /// Vertical position.
    pub y: f64,
}
/// A circle defined by its center and radius.
#[derive(Clone)]
pub struct Circle {
    /// The center point.
    pub center: Point,
    /// The radius in the same units as `center`.
    pub radius: f64,
}
```

