// src/lib.rs.d.ts
/** A point in 2D space. */
export class Point {
    private [" "]: 'rustdoc_test_crate::Point';

    /** Horizontal position. */
    x: number;

    /** Vertical position. */
    y: number;

    constructor(x: number, y: number);
}

/** A circle defined by its center and radius. */
export class Circle {
    private [" "]: 'rustdoc_test_crate::Circle';

    /** The center point. */
    center: Point;

    /** The radius in the same units as `center`. */
    radius: number;

    constructor(center: Point, radius: number);
}
