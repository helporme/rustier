/// class wrapper for `crate::S`
#[napi(js_name = "__cursed_rustdoc_test_crate__S")]
pub struct __cursed_rustdoc_test_crate__S {
    __cursed_root: Rc<RefCell<Rc<dyn __cursed::Projection<crate::S>>>>,
}
#[napi]
impl __cursed_rustdoc_test_crate__S {}
#[allow(dead_code)]
fn __cursed_coerce___cursed_rustdoc_test_crate__S<'a>(
    val: napi::bindgen_prelude::Unknown<'a>,
) -> napi::Result<__cursed::Coerced<crate::S>> {
    let __cursed_env_raw = napi::JsValue::value(&val).env;
    let __cursed_raw = napi::JsValue::raw(&val);
    if let Ok(__cursed_inst) = unsafe {
        napi::bindgen_prelude::ClassInstance::<
            __cursed_rustdoc_test_crate__S,
        >::from_napi_value(__cursed_env_raw, __cursed_raw)
    } {
        return Ok(
            __cursed::Coerced::Projected(__cursed_inst.__cursed_root.borrow().clone()),
        );
    }
    Err(
        napi::Error::from_reason(
            format!(
                "expected an instance of class `S`; got a plain object, but `S` cannot be built from an object literal (private fields or non-clonable struct child)"
            ),
        ),
    )
}
