{
  "name": "rustier-next",
  "version": "0.0.1",
  "description": "Rustier plugins implemented using Rustier.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helporme/rustier.git",
    "directory": "packages/rustier-next"
  },
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": "./dist/index.mjs"
  },
  "scripts": {
    "build:bootstrap": "pnpm --filter rustier run build",
    "build": "pnpm run build:bootstrap && tsdown",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "rustier": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "rolldown": "^1.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "peerDependencies": {
    "rolldown": "^1.0.0",
    "vite": "^8.0.0"
  }
}
