{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
  },
  "include": [
    "src",
    "packages/rustier-native/index.js",
    "packages/rustier-native/src",
    "packages/rustier-native/target",
    "packages/rustier-native/index.d.ts",
  ],
  "exclude": ["node_modules", "dist"],
}
