{
  "name": "rustier",
  "version": "0.1.2",
  "description": "Rustier plugins implemented using Rustier.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helporme/rustier.git",
    "directory": "packages/rustier"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./tsdown": "./dist/tsdown.mjs",
    "./vite": "./dist/vite.mjs"
  },
  "scripts": {
    "build/dev": "tsdown --env.runtimeSource local",
    "build/release": "tsdown",
    "test": "pnpm run build/dev && pnpm --dir ../../crates/server run build:dev && vitest run && pnpm --filter library-example run build",
    "check": "tsc --noEmit",
    "publish:bindings": "node ./npm/publish.mjs",
    "prepublishOnly": "npm run build/release && npm run publish:bindings"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "rustier-bindings-unknown-unknown-unknown": "0.1.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "rolldown": "^1.0.0",
    "rustier-bootstrap": "npm:rustier@0.1.0-bootstrap.1",
    "rustier-legacy-tests": "npm:rustier@0.0.0-bootstrap",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "rolldown": "^1.0.0",
    "vite": "^8.3.0"
  },
  "peerDependenciesMeta": {
    "vite": { "optional": true }
  }
}
