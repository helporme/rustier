{
  "name": "rustier",
  "version": "0.0.0-bootstrap",
  "publishConfig": { "tag": "bootstrap" },
  "description": "Inline Rust macros for JavaScript and TypeScript builds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helporme/rustier.git",
    "directory": "packages/rustier"
  },
  "type": "module",
  "imports": { "#server": "./dist/rustier-server.js" },
  "files": ["dist"],
  "exports": {
    ".": "./dist/index.mjs",
    "./rolldown": "./dist/rolldown.mjs",
    "./tsdown": "./dist/tsdown.mjs",
    "./vite": "./dist/vite.mjs"
  },
  "scripts": {
    "build:native": "pnpm --dir ../../crates/server run build",
    "build:ts": "tsdown",
    "build": "pnpm run build:native && pnpm run build:ts",
    "test": "pnpm run build && vitest run",
    "build:release": "pnpm --dir ../../crates/server run build:release && pnpm run build:ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "rolldown": "^1.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "rolldown": "^1.0.0",
    "tsdown": "^0.22.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": { "optional": true },
    "tsdown": { "optional": true },
    "rolldown": { "optional": true }
  }
}
