{
  "name": "library-example",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "A simple example library built by tsdown",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "rebuild": "pnpm run rebuild:plugin && pnpm run build",
    "rebuild:plugin": "pnpm --dir ../../packages/rustier-next run build"
  },
  "devDependencies": {
    "rustier": "workspace:rustier-next@*",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.2"
  }
}
